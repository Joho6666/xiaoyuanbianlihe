/* 分包页面不能 @import 主包页面 WXSS；这里保留活动瀑布流所需的局部样式。 */

.waterfall {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  width: 100%;
  padding: 16rpx;
  box-sizing: border-box;
  align-items: flex-start;
}

.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wf-card {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border: 1rpx solid #f0f0f0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.wf-activity-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 3;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #ff2442 0%, #ff6b4a 100%);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.wf-cover-wrap,
.wf-video-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--surface-container-low);
}

.wf-cover-wrap {
  height: 320rpx;
}

.wf-cover-wrap.wf-cover-wrap-ready {
  min-height: 0;
}

.wf-cover {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 220ms ease;
}

.wf-cover-ready {
  opacity: 1;
}

.wf-video-wrap {
  height: 0;
  padding-bottom: 125%;
  box-sizing: border-box;
  background: var(--on-surface);
}

.wf-video-el {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.wf-media-skeleton {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(90deg, var(--surface-container) 25%, var(--surface-container-low) 50%, var(--surface-container) 75%);
  background-size: 220% 100%;
}

.wf-media-skeleton-hidden {
  opacity: 0;
  pointer-events: none;
}

.video-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  z-index: 2;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.wf-text-card {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx 22rpx;
  background: linear-gradient(145deg, var(--secondary-container), var(--primary-container));
  box-sizing: border-box;
  flex-shrink: 0;
}

.wf-text-only {
  overflow: hidden;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--on-secondary-container);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
}

.wf-info {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  padding: 16rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.wf-title {
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #111111;
  font-weight: 700;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-word;
}

.wf-footer,
.wf-author,
.wf-actions {
  display: flex;
  align-items: center;
}

.wf-footer {
  justify-content: space-between;
  gap: 8rpx;
}

.wf-author {
  flex: 1;
  min-width: 0;
  gap: 6rpx;
}

.wf-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.wf-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: #888888;
}

.wf-actions {
  gap: 12rpx;
  flex-shrink: 0;
}

.wf-favor {
  display: flex;
  align-items: center;
  padding: 4rpx;
}

.favor-icon {
  font-size: 32rpx;
  color: #bbbbbb;
  line-height: 1;
}

.wf-favor.favored .favor-icon {
  color: #c9a227;
}

.wf-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.like-icon {
  font-size: 28rpx;
}

.like-num {
  font-size: 24rpx;
  color: #888888;
}

.wf-like.liked .like-num {
  color: #ff2442;
}

.load-status {
  padding: 40rpx 0;
  text-align: center;
}

.load-status.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-emoji {
  margin-bottom: 16rpx;
  font-size: 72rpx;
}

.load-text {
  font-size: 28rpx;
  color: #9a9a9a;
}

.act-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.act-banner-wrap {
  padding: 16rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.act-banner-swiper {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(66, 96, 137, 0.18);
}

.act-banner-slide {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.act-banner-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.act-banner-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #426089 0%, #6b94c4 100%);
}

.act-banner-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70%;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.55) 100%);
}

.act-banner-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx 22rpx;
  box-sizing: border-box;
}

.act-banner-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  line-height: 1.35;
}

.act-banner-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

.act-banner-cta {
  display: inline-block;
  margin-top: 14rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffd24a;
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 700;
}

.act-banner-empty {
  margin: 16rpx 24rpx;
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  background: #f4f7fc;
  border: 1rpx dashed #c8d4e8;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.act-empty-icon {
  font-size: 40rpx;
}

.act-empty-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
}

.act-empty-sub {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.5;
}

.act-section-head {
  padding: 20rpx 24rpx 12rpx;
}

.act-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111111;
}

.act-section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.act-search {
  display: flex;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(66, 96, 137, 0.14);
  background: #f7f9fc;
  box-sizing: border-box;
}

.act-search-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(66, 96, 137, 0.35);
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}

.act-search-ico::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 3rpx;
  background: rgba(66, 96, 137, 0.45);
  right: -5rpx;
  bottom: -1rpx;
  transform: rotate(42deg);
  border-radius: 2rpx;
}

.act-search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.act-search-ph {
  color: #94a3b8;
  font-size: 26rpx;
}

.act-search-clear {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  color: #426089;
  font-weight: 600;
}

.act-hint {
  padding: 0 24rpx 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.act-detail-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.act-detail-sheet {
  width: 100%;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 0 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.act-detail-grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  align-self: center;
  margin-bottom: 8rpx;
}

.act-detail-scroll {
  flex: 1;
  max-height: 62vh;
  padding: 8rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.act-detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 20rpx;
  line-height: 1.35;
}

.act-detail-block {
  margin-bottom: 22rpx;
}

.act-detail-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #426089;
  margin-bottom: 8rpx;
}

.act-detail-text {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.55;
  white-space: pre-wrap;
}

.act-detail-close {
  margin: 8rpx 28rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #426089;
  background: #eef3ff;
  border-radius: 16rpx;
}

.waterfall {
  padding: 0 16rpx;
}
