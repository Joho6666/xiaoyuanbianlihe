/* 分包页面不能 @import 主包页面 WXSS；复制本页实际使用的基础表单样式。 */

.page {
  padding: 24rpx;
  background: #f5f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  padding: 10rpx 4rpx 18rpx;
}

.hero-title,
.hero-sub {
  display: block;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1f2b3d;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7c8594;
}

.block {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 43, 61, 0.06);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 0;
}

.label {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  color: #6f7580;
  font-size: 24rpx;
}

.campus-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.campus-count {
  flex: 1;
  font-size: 24rpx;
  color: #6f7580;
}

.campus-action-btn,
.upload-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ecf2fb;
  color: #426089;
  font-size: 24rpx;
  font-weight: 600;
}

.campus-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.campus-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 2rpx solid #d7deea;
  border-radius: 999rpx;
  padding: 12rpx 22rpx 12rpx 14rpx;
  min-height: 60rpx;
}

.campus-name {
  font-size: 26rpx;
  color: #6b7383;
  line-height: 1.2;
}

.campus-mark {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #c7d0df;
  margin-right: 12rpx;
  color: transparent;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.campus-chip-on {
  background: #e6f0ff;
  border-color: #1f6feb;
}

.campus-chip-on .campus-mark {
  background: #1f6feb;
  border-color: #1f6feb;
  color: #ffffff;
}

.campus-chip-on .campus-name {
  color: #1f3a64;
  font-weight: 700;
}

.image-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 10rpx;
}

.btn {
  margin-top: 20rpx;
  background: #426089;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.act-status {
  margin: 16rpx 0 24rpx;
  padding: 20rpx 24rpx;
  background: #e8f5e9;
  border-radius: 16rpx;
}

.act-status--muted {
  background: #f5f5f5;
}

.act-status-line {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1b5e20;
}

.act-status--muted .act-status-line {
  color: #5b6b7a;
  font-weight: 500;
}

.act-status-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5b6b7a;
}

.end-at-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.end-at-picker {
  padding: 16rpx 24rpx;
  background: #f0f4f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1f2b3d;
}

.end-at-clear {
  font-size: 26rpx;
  color: #1565c0;
  padding: 12rpx;
}

.btn-secondary {
  margin-top: 20rpx;
  background: #fff;
  color: #1565c0;
  border: 2rpx solid #1565c0;
}

.btn-danger {
  margin-top: 20rpx;
  background: #ffebee;
  color: #c62828;
}

/* 轮播卡片：避免与全局 .h1 叠加大间距 */
.slide-block {
  overflow: visible;
}

.slide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.slide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2b3d;
}

.slide-del {
  font-size: 26rpx;
  color: #c62828;
  font-weight: 600;
  padding: 8rpx 12rpx;
}

.slide-uploading {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5b6b7a;
}

.slide-fields {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* 小程序 input 必须给足高度，否则会被压成细条 */
.act-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  height: 96rpx;
  line-height: 44rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
  background: #f6f7fb;
  border-radius: 16rpx;
  border: 1rpx solid #e5e9f0;
  font-size: 28rpx;
  color: #243245;
}

.act-input--last {
  margin-bottom: 0;
}

/* textarea：固定最小高度 + auto-height 可增高 */
.act-textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  background: #f6f7fb;
  border-radius: 16rpx;
  border: 1rpx solid #e5e9f0;
  font-size: 28rpx;
  color: #243245;
  line-height: 1.6;
}

.act-textarea--lg {
  min-height: 260rpx;
}

.slide-preview {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e8edf5;
}

.slide-img {
  width: 100%;
  height: 100%;
}

.add-slide {
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #426089;
  color: #426089;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
