<view class="discover-container">
  <campus-page-header title="发现" subtitle="探索校园多元生活与同频伙伴" campus="{{campusName || '当前校区'}}" bindcampus="onChangeCampus" />

  <!-- 核心频道矩阵 (2x2 Grid) -->
  <view class="channel-section">
    <section-header title="核心频道" subtitle="全域校园矩阵" />
    <view class="service-feed"><service-card title="同频搭子" description="先看今晚要做什么" icon="🎯" tone="coral" badge="热门组局" bindtap="onOpenTongpin"/><service-card title="友桥 UniBridge" description="母语与目标语言互助" icon="🌐" tone="green" badge="语言交换" bindtap="onOpenUniBridge"/><service-card title="校园集市" description="闲置好物，校园内交易" icon="🛍️" tone="blue" badge="现已开通" bindtap="goToMarket"/><service-card title="校园活动" description="讲座、社团与竞赛日程" icon="🎪" tone="blue" badge="官方活动" bindtap="goToEvents"/></view>

    <view class="channel-grid">
      <!-- 1. 同频搭子 (Tongpin) -->
      <view class="channel-card card-buddy" bindtap="onOpenTongpin">
        <view class="card-header">
          <view class="channel-icon-wrap icon-buddy-bg">
            <text class="channel-emoji">🎯</text>
          </view>
          <view class="status-tag tag-active">热门组局</view>
        </view>
        <view class="card-body">
          <text class="channel-name">同频</text>
          <text class="channel-desc">找搭子 · 遇见心动的人</text>
          <view class="channel-tags">
            <text class="mini-tag">羽毛球</text>
            <text class="mini-tag">自习</text>
            <text class="mini-tag">拼车</text>
          </view>
        </view>
      </view>

      <!-- 2. 友桥国际交流 (UniBridge) -->
      <view class="channel-card card-bridge" bindtap="onOpenUniBridge">
        <view class="card-header">
          <view class="channel-icon-wrap icon-bridge-bg">
            <text class="channel-emoji">🌐</text>
          </view>
          <view class="status-tag tag-active">语言交换</view>
        </view>
        <view class="card-body">
          <text class="channel-name">友桥 UniBridge</text>
          <text class="channel-desc">中外学生交流 · 语言搭子</text>
          <view class="channel-tags">
            <text class="mini-tag">English</text>
            <text class="mini-tag">语伴互助</text>
          </view>
        </view>
      </view>

      <!-- 3. 校园二手集市 (Market) - 现已可用，直接进入 -->
      <view class="channel-card card-market" bindtap="goToMarket">
        <view class="card-header">
          <view class="channel-icon-wrap icon-market-bg">
            <text class="channel-emoji">🛍️</text>
          </view>
          <view class="status-tag tag-active">现已开通</view>
        </view>
        <view class="card-body">
          <text class="channel-name">校园集市</text>
          <text class="channel-desc">闲置好物 · 教材课本 · 数码</text>
          <view class="channel-tags">
            <text class="mini-tag">担保安全</text>
            <text class="mini-tag">校园自提</text>
          </view>
        </view>
      </view>

      <!-- 4. 校园活动日程 (Events) - 现已可用，直接进入 -->
      <view class="channel-card card-event" bindtap="goToEvents">
        <view class="card-header">
          <view class="channel-icon-wrap icon-event-bg">
            <text class="channel-emoji">🎪</text>
          </view>
          <view class="status-tag tag-active">官方活动</view>
        </view>
        <view class="card-body">
          <text class="channel-name">校园活动</text>
          <text class="channel-desc">社团汇演 · 官方讲座 · 竞赛</text>
          <view class="channel-tags">
            <text class="mini-tag">日程看板</text>
            <text class="mini-tag">现场签到</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 校园服务快链 -->
  <view class="service-section">
    <view class="section-title-row">
      <text class="section-title">校园互助生活</text>
    </view>

    <view class="service-strip">
      <view class="service-item" bindtap="goToTreehole">
        <view class="service-icon-box">
          <text class="service-emoji">💬</text>
        </view>
        <text class="service-label">校园树洞</text>
        <text class="service-hint">精选话题</text>
      </view>

      <view class="service-item" bindtap="onShowQuickTip" data-type="help">
        <view class="service-icon-box">
          <text class="service-emoji">🤝</text>
        </view>
        <text class="service-label">校园互助</text>
        <text class="service-hint">跑腿带物</text>
      </view>

      <view class="service-item" bindtap="onShowQuickTip" data-type="lost">
        <view class="service-icon-box">
          <text class="service-emoji">🔍</text>
        </view>
        <text class="service-label">失物招领</text>
        <text class="service-hint">寻物寻主</text>
      </view>
    </view>
  </view>

  <!-- “校园此刻”多频道生态流预览 -->
  <view class="pulse-section">
    <view class="section-title-row">
      <text class="section-title">校园此刻 · 聚合预览</text>
      <text class="section-sub">三合一实时动态流</text>
    </view>

    <view class="pulse-card">
      <view class="pulse-item" bindtap="onOpenTongpin">
        <view class="pulse-badge buddy-badge">同频搭子</view>
        <view class="pulse-content">
          <text class="pulse-text">今晚 19:30 室内体育馆羽毛球单打缺 1 人</text>
          <text class="pulse-meta">桂航校区 · 已报 3/4 · 5分钟前</text>
        </view>
        <text class="pulse-arrow">→</text>
      </view>

      <view class="pulse-divider"></view>

      <view class="pulse-item" bindtap="onOpenUniBridge">
        <view class="pulse-badge bridge-badge">友桥语伴</view>
        <view class="pulse-content">
          <text class="pulse-text">Emma 寻找中文练习伙伴 · 期待互补交流</text>
          <text class="pulse-meta">母语英语 · 学习中文日常 · 桂航校区</text>
        </view>
        <text class="pulse-arrow">→</text>
      </view>

      <view class="pulse-divider"></view>

      <view class="pulse-item" bindtap="goToMarket">
        <view class="pulse-badge market-badge">二手集市</view>
        <view class="pulse-content">
          <text class="pulse-text">九成新 AirPods Pro 2代，考研出闲置</text>
          <text class="pulse-meta">￥699 · 支持现场验机自提 · 刚刚上架</text>
        </view>
        <text class="pulse-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 底部安全间距与版权 -->
  <view class="bottom-footer">
    <text class="footer-text">校园便利盒 · 同频搭子 · 友桥 UniBridge 统一校园生态</text>
  </view>

  <!-- 频道详情 / 预览弹窗 (原生弹窗体验) -->
  <view class="preview-modal-mask" wx:if="{{showModal}}" bindtap="closeModal" catchtouchmove="stopBubble">
    <view class="preview-modal-box" catchtap="stopBubble">
      <view class="modal-indicator"></view>
      <view class="modal-header-row">
        <view class="modal-header-left">
          <view class="modal-badge {{modalData.badgeClass}}">{{modalData.badgeText}}</view>
          <text class="modal-title">{{modalData.title}}</text>
        </view>
        <view class="modal-close-btn" bindtap="closeModal">✕</view>
      </view>
      <text class="modal-desc">{{modalData.description}}</text>

      <view class="modal-feature-list">
        <view class="modal-feature-item" wx:for="{{modalData.features}}" wx:key="index">
          <text class="feature-dot">✓</text>
          <text class="feature-text">{{item}}</text>
        </view>
      </view>

      <!-- 双语预览演示 (如果为 UniBridge) -->
      <view class="bilingual-demo-box" wx:if="{{modalData.isUniBridge}}">
        <view class="bilingual-header">
          <text class="bilingual-label">Language Mode / 语言模式</text>
          <view class="lang-switch-pill" catchtap="toggleBilingualLang">
            <text class="{{currentLang === 'zh-CN' ? 'lang-btn-active' : 'lang-btn'}}">中</text>
            <text class="{{currentLang === 'en-US' ? 'lang-btn-active' : 'lang-btn'}}">EN</text>
          </view>
        </view>
        <view class="bilingual-sample">
          <text class="sample-title">{{currentLang === 'zh-CN' ? '跨文化相遇，在校园连接世界' : 'Meet locals. Meet the world on campus.'}}</text>
          <text class="sample-sub">{{currentLang === 'zh-CN' ? '面向中国学生与国际留学生的双向语言互助平台。' : 'A peer-to-peer exchange for Chinese & international students.'}}</text>
        </view>
      </view>

      <view class="modal-action-btn" bindtap="closeModal">
        <text>我知道了</text>
      </view>
    </view>
  </view>
</view>
