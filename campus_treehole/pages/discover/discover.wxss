.discover-container { min-height:100vh; padding:0 24rpx calc(160rpx + env(safe-area-inset-bottom)); background:#f3f7fd; box-sizing:border-box; }
.discover-intro { padding:26rpx 8rpx 24rpx; display:flex; flex-direction:column; gap:8rpx; }.discover-eyebrow { color:#2f76ff; font-size:19rpx; letter-spacing:3rpx; font-weight:700; }.discover-title { color:#172033; font-size:40rpx; line-height:1.25; font-weight:800; }.discover-subtitle { color:#78869b; font-size:24rpx; }
.service-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18rpx; }.discover-card { min-height:188rpx; padding:24rpx; border-radius:30rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:flex-start; box-shadow:0 10rpx 28rpx rgba(23,32,51,.05); }.card-icon { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; margin-bottom:17rpx; border-radius:20rpx; font-size:28rpx; font-weight:800; }.card-title { font-size:29rpx; color:#172033; font-weight:800; }.card-desc { margin-top:7rpx; color:#65748a; font-size:21rpx; line-height:1.5; }
.buddy{background:#e8f1ff}.buddy .card-icon{color:#2f76ff;background:#fff}.heart{background:#fff0f3}.heart .card-icon{color:#ff657a;background:#fff}.market{background:#e4f8f0}.market .card-icon{color:#199b70;background:#fff}.bridge{background:#eeeaff}.bridge .card-icon{color:#7460d1;background:#fff}.mutual{background:#e7f5ff}.mutual .card-icon{color:#2384c6;background:#fff}.lost{background:#fff2e3}.lost .card-icon{color:#e88932;background:#fff}.events{background:#f0ebff}.events .card-icon{color:#8263d2;background:#fff}.treehole{background:#fff}.treehole .card-icon{color:#6f7f96;background:#eef2f7}.discover-footer { padding:30rpx 0; color:#98a5b7; text-align:center; font-size:21rpx; }
