/* pages/discover/discover.wxss - 发现频道样式 */

.discover-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.service-feed{display:grid;gap:16rpx;margin-bottom:24rpx}.discover-container .channel-grid{display:none}

/* 顶部头部 */
.discover-header {
  padding: 32rpx 32rpx 20rpx;
}

.header-main {
  display: flex;
  flex-direction: column;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2c3338;
  letter-spacing: -0.5rpx;
}

.campus-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(116, 124, 129, 0.16);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(44, 51, 56, 0.04);
}

.campus-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #426089;
  margin-right: 10rpx;
}

.campus-name {
  font-size: 24rpx;
  color: #426089;
  font-weight: 600;
}

.page-subtitle {
  font-size: 26rpx;
  color: #747c81;
  margin-top: 8rpx;
}

/* 区域通用标题 */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3338;
}

.section-sub {
  font-size: 22rpx;
  color: #abb3b9;
}

/* 核心频道矩阵 (2x2) */
.channel-section {
  margin-top: 16rpx;
}

.channel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 32rpx;
}

.channel-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(44, 51, 56, 0.04);
  border: 1rpx solid rgba(116, 124, 129, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 230rpx;
  transition: transform 0.15s ease;
}

.channel-card:active {
  transform: scale(0.97);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.channel-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-buddy-bg {
  background: #fff3e0;
}

.icon-bridge-bg {
  background: #e8f4fd;
}

.icon-market-bg {
  background: #fdf0ed;
}

.icon-event-bg {
  background: #f0fdf4;
}

.channel-emoji {
  font-size: 36rpx;
}

.status-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.tag-active {
  background: #eef2ff;
  color: #426089;
}

.tag-upcoming {
  background: #fff7ed;
  color: #ea580c;
}

.tag-bilingual {
  background: #f0fdfa;
  color: #0d9488;
}

.card-body {
  display: flex;
  flex-direction: column;
}

.channel-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3338;
}

.channel-desc {
  font-size: 22rpx;
  color: #747c81;
  margin-top: 6rpx;
  line-height: 1.35;
}

.channel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.mini-tag {
  font-size: 20rpx;
  color: #596065;
  background: #f4f6f9;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 校园服务快链 */
.service-section {
  margin-top: 36rpx;
}

.service-strip {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  margin: 0 32rpx;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.service-item:active {
  opacity: 0.7;
}

.service-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.service-emoji {
  font-size: 36rpx;
}

.service-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c3338;
}

.service-hint {
  font-size: 20rpx;
  color: #abb3b9;
  margin-top: 2rpx;
}

/* 校园此刻生态流 */
.pulse-section {
  margin-top: 36rpx;
  padding: 0 32rpx;
}

.pulse-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.pulse-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.pulse-item:active {
  opacity: 0.75;
}

.pulse-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  margin-right: 16rpx;
}

.buddy-badge {
  background: #ffedd5;
  color: #c2410c;
}

.bridge-badge {
  background: #e0f2fe;
  color: #0369a1;
}

.market-badge {
  background: #fce7f3;
  color: #be185d;
}

.pulse-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pulse-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3338;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pulse-meta {
  font-size: 20rpx;
  color: #747c81;
  margin-top: 4rpx;
}

.pulse-arrow {
  font-size: 28rpx;
  color: #abb3b9;
  margin-left: 12rpx;
}

.pulse-divider {
  height: 1rpx;
  background: rgba(116, 124, 129, 0.08);
}

/* 页脚 */
.bottom-footer {
  text-align: center;
  padding: 40rpx 32rpx 20rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #abb3b9;
}

/* 弹窗蒙层与内容 */
.preview-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.preview-modal-box {
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

.modal-indicator {
  width: 72rpx;
  height: 8rpx;
  background: #e3e9ee;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.modal-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.modal-header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.modal-close-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #f0f3f6;
  color: #747c81;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 700;
}

.modal-close-btn:active {
  background: #e2e8f0;
}

.modal-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2c3338;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-desc {
  font-size: 26rpx;
  color: #596065;
  margin-top: 12rpx;
  line-height: 1.5;
}

.modal-feature-list {
  margin-top: 24rpx;
  background: #f7f9fc;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.modal-feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.modal-feature-item:last-child {
  margin-bottom: 0;
}

.feature-dot {
  color: #426089;
  font-weight: 700;
  margin-right: 12rpx;
  font-size: 26rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #2c3338;
}

/* 双语演示切换区 */
.bilingual-demo-box {
  margin-top: 24rpx;
  border: 1rpx solid #e0f2fe;
  background: #f0f9ff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.bilingual-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bilingual-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #0369a1;
}

.lang-switch-pill {
  display: flex;
  background: #e0f2fe;
  border-radius: 999rpx;
  padding: 4rpx;
}

.lang-btn {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #0369a1;
}

.lang-btn-active {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0369a1;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(3, 105, 161, 0.15);
}

.bilingual-sample {
  display: flex;
  flex-direction: column;
}

.sample-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0c4a6e;
}

.sample-sub {
  font-size: 22rpx;
  color: #0284c7;
  margin-top: 4rpx;
}

.modal-action-btn {
  margin-top: 32rpx;
  height: 88rpx;
  background: #426089;
  color: #ffffff;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-action-btn:active {
  opacity: 0.9;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
