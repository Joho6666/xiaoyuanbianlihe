/* packageBuddy/pages/buddy-create/buddy-create.wxss */
.create-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 20rpx;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cat-item {
  background: #f8fafc;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-item-active {
  background: #e9eff7;
  border-color: #426089;
}

.cat-item-active .cat-name {
  color: #426089;
  font-weight: 700;
}

.cat-name {
  font-size: 24rpx;
  color: #596065;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.group-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 12rpx;
}

.input-control {
  width: 100%;
  height: 80rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
}

.placeholder-text {
  color: #abb3b9;
  font-size: 24rpx;
}

.time-picker-row {
  display: flex;
  gap: 20rpx;
}

.picker-box {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  color: #2c3338;
  font-weight: 600;
}

.radio-row {
  display: flex;
  gap: 32rpx;
  padding-top: 8rpx;
}

.radio-label {
  font-size: 26rpx;
  color: #596065;
  display: flex;
  align-items: center;
}

.textarea-control {
  width: 100%;
  height: 200rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
  line-height: 1.5;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(44, 51, 56, 0.04);
  z-index: 100;
}

.submit-btn {
  background: #426089;
  color: #ffffff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.submit-btn:active {
  opacity: 0.9;
}
