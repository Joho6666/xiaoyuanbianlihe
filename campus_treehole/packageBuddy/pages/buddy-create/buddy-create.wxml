<!-- packageBuddy/pages/buddy-create/buddy-create.wxml - 发起搭子组局 -->
<view class="create-container">
  <view class="form-card">
    <view class="section-title">选择搭子类型</view>
    <view class="cat-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-item {{category === item.id ? 'cat-item-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >
        <text class="cat-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="form-group">
      <view class="group-label">组局标题 *</view>
      <input
        class="input-control"
        placeholder="例如：周六下午体育馆羽毛球单打缺1人"
        placeholder-class="placeholder-text"
        value="{{title}}"
        bindinput="onTitleInput"
        maxlength="40"
      />
    </view>

    <view class="form-group">
      <view class="group-label">活动开始时间 *</view>
      <view class="time-picker-row">
        <picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="onDateChange">
          <view class="picker-box">{{startDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{startTime}}" bindchange="onTimeChange">
          <view class="picker-box">{{startTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-group">
      <view class="group-label">集合地点</view>
      <input
        class="input-control"
        placeholder="例如：花江校区风雨操场2号场 / 桂航食堂二楼"
        placeholder-class="placeholder-text"
        value="{{location}}"
        bindinput="onLocationInput"
        maxlength="40"
      />
    </view>

    <view class="form-group">
      <view class="group-label">人数上限 (含发起人)</view>
      <slider
        min="2"
        max="16"
        step="1"
        value="{{maxPeople}}"
        show-value
        activeColor="#426089"
        bindchange="onMaxPeopleChange"
      />
    </view>

    <view class="form-group">
      <view class="group-label">性别要求</view>
      <radio-group class="radio-row" bindchange="onGenderChange">
        <label class="radio-label">
          <radio value="any" checked="{{genderRequirement === 'any'}}" color="#426089" /> 不限
        </label>
        <label class="radio-label">
          <radio value="female_only" checked="{{genderRequirement === 'female_only'}}" color="#426089" /> 仅限女生
        </label>
        <label class="radio-label">
          <radio value="male_only" checked="{{genderRequirement === 'male_only'}}" color="#426089" /> 仅限男生
        </label>
      </radio-group>
    </view>

    <view class="form-group">
      <view class="group-label">详细说明 / 组局约定</view>
      <textarea
        class="textarea-control"
        placeholder="补充活动费用说明（如AA分摊、自带装备）、迟到规则或注意事项..."
        placeholder-class="placeholder-text"
        value="{{description}}"
        bindinput="onDescInput"
        maxlength="300"
      />
    </view>
  </view>

  <view class="submit-bar">
    <button class="submit-btn" disabled="{{submitting}}" bindtap="onSubmit">立即发起组局</button>
  </view>
</view>
