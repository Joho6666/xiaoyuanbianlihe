<!-- packageBuddy/pages/buddy-square/buddy-square.wxml - 同频搭子广场 -->
<view class="square-container">
  <!-- 顶栏搜索 -->
  <view class="search-header">
    <view class="search-box">
      <icon type="search" size="16" color="#747c81" />
      <input
        class="search-input"
        placeholder="搜羽毛球、自习、食堂拼饭、开黑..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>
    <view class="status-tabs">
      <view class="status-tab {{statusFilter === 'OPEN' ? 'status-tab-active' : ''}}" data-status="OPEN" bindtap="onToggleStatus">招募中</view>
      <view class="status-tab {{statusFilter === 'all' ? 'status-tab-active' : ''}}" data-status="all" bindtap="onToggleStatus">全部</view>
    </view>
  </view>

  <!-- 分类水平滚动栏 -->
  <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-chip {{currentCategory === item.id ? 'cat-chip-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelectCategory"
    >
      <text class="cat-chip-emoji">{{item.emoji}}</text>
      <text class="cat-chip-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 搭子卡片列表 (事件优先，拒绝 Tinder 颜值卡) -->
  <view class="card-list">
    <view
      wx:for="{{posts}}"
      wx:key="_id"
      class="buddy-card"
      data-id="{{item._id}}"
      bindtap="goToDetail"
    >
      <view class="card-top">
        <view class="tag-row">
          <view class="cat-badge">
            <text class="cat-badge-emoji">{{item.categoryEmoji}}</text>
            <text class="cat-badge-text">{{item.categoryName}}</text>
          </view>
          <text class="urgency-badge" wx:if="{{item.urgencyBadge}}">{{item.urgencyBadge}}</text>
          <text class="gender-badge" wx:if="{{item.genderRequirement === 'female_only'}}">仅限女生</text>
          <text class="gender-badge" wx:elif="{{item.genderRequirement === 'male_only'}}">仅限男生</text>
        </view>
        <view class="status-indicator status-{{item.status}}">
          <text wx:if="{{item.status === 'OPEN'}}">招募中</text>
          <text wx:elif="{{item.status === 'FULL'}}">已满员</text>
          <text wx:elif="{{item.status === 'FINISHED'}}">已完成</text>
          <text wx:else>已结束</text>
        </view>
      </view>

      <!-- 核心大标题：突出“事情与约定” -->
      <view class="card-title">{{item.title}}</view>

      <!-- 时间与地点：醒目呈现 -->
      <view class="card-meta-box">
        <view class="meta-item">
          <text class="meta-icon">⏰</text>
          <text class="meta-text">{{item.timeDisplay}}</text>
        </view>
        <view class="meta-item" wx:if="{{item.location}}">
          <text class="meta-icon">📍</text>
          <text class="meta-text">{{item.location}}</text>
        </view>
      </view>

      <!-- 底部行动行：发起人 + 席位状态 + 动作 -->
      <view class="card-bottom">
        <view class="author-box">
          <image class="author-avatar" src="{{item.author.avatarUrl || '/images/avatar_default.png'}}" mode="aspectFill" />
          <text class="author-name">{{item.author.nickName || '发起人'}}</text>
        </view>

        <view class="seat-and-action">
          <view class="headcount-box">
            <text class="headcount-current">{{item.acceptedCount}}</text>
            <text class="headcount-divider">/</text>
            <text class="headcount-total">{{item.maxPeople}}人</text>
            <text class="headcount-remain" wx:if="{{item.status === 'OPEN' && item.remainPeople > 0}}">差{{item.remainPeople}}人</text>
          </view>
          <view class="card-action-btn {{item.status === 'OPEN' ? 'action-btn-join' : 'action-btn-view'}}">
            {{item.status === 'OPEN' ? '申请加入' : '查看'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
      <view class="empty-icon">🏸</view>
      <text class="empty-title">今晚还没人约？</text>
      <text class="empty-sub">做第一个发起组局的人，随时成局！</text>
      <button class="empty-btn" bindtap="goToCreate">🚀 立即发起</button>
    </view>

    <!-- 加载指示 -->
    <view class="loading-bar" wx:if="{{loading}}">加载中...</view>
  </view>

  <!-- 悬浮发起按钮 -->
  <view class="fab-btn" bindtap="goToCreate">
    <text class="fab-icon">+</text>
    <text class="fab-text">发起组局</text>
  </view>
</view>
