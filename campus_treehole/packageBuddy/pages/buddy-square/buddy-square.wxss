/* packageBuddy/pages/buddy-square/buddy-square.wxss */
.square-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.search-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.08);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  margin-left: 12rpx;
  color: #2c3338;
}

.search-placeholder {
  color: #abb3b9;
}

.status-tabs {
  display: flex;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 4rpx;
}

.status-tab {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #747c81;
}

.status-tab-active {
  background: #ffffff;
  color: #426089;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(66, 96, 137, 0.15);
}

.category-scroll {
  display: flex;
  white-space: nowrap;
  background: #ffffff;
  padding: 12rpx 24rpx 18rpx;
  box-sizing: border-box;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #f1f4f8;
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.cat-chip-active {
  background: #e9eff7;
  border: 1rpx solid #426089;
}

.cat-chip-active .cat-name {
  color: #426089;
  font-weight: 700;
}

.cat-name {
  font-size: 24rpx;
  color: #596065;
}

.card-list {
  padding: 24rpx 28rpx;
}

.buddy-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.tag-row {
  display: flex;
  gap: 12rpx;
}

.cat-badge {
  font-size: 20rpx;
  background: #ffedd5;
  color: #c2410c;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.gender-badge {
  font-size: 20rpx;
  background: #fce7f3;
  color: #be185d;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-indicator {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.status-OPEN {
  background: #ecfdf5;
  color: #059669;
}

.status-FULL {
  background: #fef2f2;
  color: #dc2626;
}

.status-FINISHED, .status-CANCELLED {
  background: #f3f4f6;
  color: #9ca3af;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3338;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.card-meta {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.meta-row {
  font-size: 22rpx;
  line-height: 1.6;
}

.meta-label {
  color: #747c81;
}

.meta-val {
  color: #2c3338;
  font-weight: 500;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 24rpx;
  color: #596065;
}

.headcount-box {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: #747c81;
}

.headcount-now {
  font-size: 32rpx;
  font-weight: 800;
  color: #426089;
}

.headcount-slash {
  margin: 0 2rpx;
}

.headcount-max {
  font-size: 22rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #abb3b9;
  margin-bottom: 24rpx;
}

.empty-btn {
  background: #426089;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.loading-bar {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #abb3b9;
}

.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 160rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #426089;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(66, 96, 137, 0.4);
  z-index: 100;
}

.fab-plus {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

.fab-text {
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 2rpx;
}
