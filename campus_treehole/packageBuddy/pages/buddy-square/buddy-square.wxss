/* packageBuddy/pages/buddy-square/buddy-square.wxss - Tongpin 搭子广场 */
.square-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.search-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.08);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  margin-left: 12rpx;
  color: #2c3338;
}

.search-placeholder {
  color: #abb3b9;
}

.status-tabs {
  display: flex;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 4rpx;
}

.status-tab {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #747c81;
}

.status-tab-active {
  background: #ffffff;
  color: #426089;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(66, 96, 137, 0.15);
}

.category-scroll {
  display: flex;
  white-space: nowrap;
  background: #ffffff;
  padding: 14rpx 24rpx 20rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.04);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: #f1f4f8;
  border-radius: 999rpx;
  margin-right: 14rpx;
}

.cat-chip-active {
  background: #e9eff7;
  border: 1rpx solid #426089;
}

.cat-chip-emoji {
  font-size: 24rpx;
}

.cat-chip-name {
  font-size: 24rpx;
  color: #596065;
}

.cat-chip-active .cat-chip-name {
  color: #426089;
  font-weight: 700;
}

.card-list {
  padding: 24rpx 28rpx;
}

.buddy-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(44, 51, 56, 0.04);
  border: 1rpx solid rgba(116, 124, 129, 0.07);
  transition: transform 0.15s ease;
}

.buddy-card:active {
  transform: scale(0.995);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  background: #eef2ff;
  color: #4338ca;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 700;
}

.cat-badge-emoji {
  font-size: 24rpx;
}

.urgency-badge {
  font-size: 20rpx;
  background: #fef2f2;
  color: #dc2626;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
  border: 1rpx solid #fecaca;
}

.gender-badge {
  font-size: 20rpx;
  background: #fdf2f8;
  color: #be185d;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-indicator {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-OPEN {
  background: #ecfdf5;
  color: #059669;
}

.status-FULL {
  background: #fef2f2;
  color: #dc2626;
}

.status-FINISHED, .status-CANCELLED {
  background: #f3f4f6;
  color: #9ca3af;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
  margin-bottom: 14rpx;
}

.card-meta-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #475569;
}

.meta-icon {
  font-size: 24rpx;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
}

.author-name {
  font-size: 24rpx;
  color: #64748b;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-and-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.headcount-box {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 24rpx;
}

.headcount-current {
  font-size: 30rpx;
  font-weight: 800;
  color: #426089;
}

.headcount-divider {
  color: #94a3b8;
  font-size: 22rpx;
}

.headcount-total {
  color: #64748b;
  font-size: 22rpx;
}

.headcount-remain {
  font-size: 22rpx;
  font-weight: 700;
  color: #ef4444;
  margin-left: 8rpx;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.card-action-btn {
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.action-btn-join {
  background: #426089;
  color: #ffffff;
}

.action-btn-view {
  background: #f1f5f9;
  color: #64748b;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 36rpx;
}

.empty-btn {
  background: #426089;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 50rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.loading-bar {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #abb3b9;
}

/* 浮动组局按钮 */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 140rpx;
  background: linear-gradient(135deg, #426089 0%, #294263 100%);
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 28rpx rgba(41, 66, 99, 0.35);
  z-index: 100;
}

.fab-icon {
  font-size: 32rpx;
  font-weight: 700;
}

.fab-text {
  font-size: 26rpx;
  font-weight: 700;
}
