/* packageBuddy/pages/buddy-detail/buddy-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.status-banner {
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner-OPEN {
  background: linear-gradient(135deg, #426089 0%, #5a7ea8 100%);
  color: #ffffff;
}

.banner-FULL {
  background: linear-gradient(135deg, #c2410c 0%, #ea580c 100%);
  color: #ffffff;
}

.banner-FINISHED, .banner-CANCELLED {
  background: #64748b;
  color: #ffffff;
}

.status-main {
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 32rpx;
  font-weight: 800;
}

.status-sub {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.cat-pill {
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  backdrop-filter: blur(8px);
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.post-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2c3338;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.spec-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.spec-item {
  display: flex;
  flex-direction: column;
}

.spec-label {
  font-size: 20rpx;
  color: #747c81;
}

.spec-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3338;
  margin-top: 4rpx;
}

.desc-box {
  margin-top: 24rpx;
}

.desc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 10rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #596065;
  line-height: 1.6;
}

.card-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 16rpx;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.author-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3338;
}

.author-tag {
  font-size: 20rpx;
  color: #059669;
  margin-top: 2rpx;
}

.chat-btn {
  background: #ecf2fb;
  color: #426089;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  position: relative;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.avatar-host {
  border: 4rpx solid #426089;
}

.member-name {
  font-size: 20rpx;
  color: #596065;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.host-badge {
  position: absolute;
  top: -6rpx;
  right: 6rpx;
  background: #426089;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
}

.app-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.08);
}

.app-item:last-child {
  border-bottom: none;
}

.app-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.app-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.app-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2c3338;
}

.app-msg {
  font-size: 22rpx;
  color: #747c81;
  margin-top: 4rpx;
}

.app-actions {
  display: flex;
  gap: 12rpx;
}

.btn-agree, .btn-reject {
  font-size: 22rpx;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  margin: 0;
  font-weight: 700;
}

.btn-agree {
  background: #426089;
  color: #ffffff;
}

.btn-reject {
  background: #f1f4f8;
  color: #747c81;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(44, 51, 56, 0.04);
  z-index: 100;
}

.bar-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
}

.btn-primary {
  background: #426089;
  color: #ffffff;
}

.btn-secondary {
  background: #ecf2fb;
  color: #426089;
}

.btn-disabled {
  background: #f1f4f8;
  color: #abb3b9;
}

.btn-pending {
  background: #fef3c7;
  color: #b45309;
}

.apply-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.apply-modal-box {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2c3338;
  text-align: center;
  margin-bottom: 24rpx;
}

.apply-textarea {
  width: 100%;
  height: 160rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
  margin-bottom: 24rpx;
}

.modal-btn-row {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin: 0;
}

.btn-cancel {
  background: #f1f4f8;
  color: #747c81;
}

.btn-confirm {
  background: #426089;
  color: #ffffff;
}
