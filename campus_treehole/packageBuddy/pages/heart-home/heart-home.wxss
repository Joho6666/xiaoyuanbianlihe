/* packageBuddy/pages/heart-home/heart-home.wxss */
page {
  background-color: #f7f9fc;
  color: #2c3338;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.heart-container {
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}
.heart-feed,.match-feed{padding:0 8rpx}.heart-container .profile-card,.heart-container .match-row-card,.heart-container .empty-state-card{display:none}
.fate-modern{margin:0 8rpx 20rpx}.fate-modern-quota{margin-bottom:14rpx;padding:16rpx 20rpx;border-radius:18rpx;background:var(--accent-soft);color:var(--accent);font-size:24rpx;font-weight:700}.heart-container .fate-card-container{display:none}

/* 顶栏分段切换：找搭子 / 心动 */
.top-nav-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.segmented-control {
  display: flex;
  background: #eef2f6;
  border-radius: 40rpx;
  padding: 6rpx;
  width: 440rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.seg-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  transition: all 0.2s ease;
}

.seg-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #556071;
}

.seg-active {
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.seg-active .seg-text {
  color: #c94a62;
  font-weight: 700;
}

/* 错误与加载提示 */
.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fce8e6;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.error-msg {
  font-size: 26rpx;
  color: #a83836;
}

.retry-btn {
  margin: 0;
  background: #a83836;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 12rpx;
}

.loading-state {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #c94a62;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #8c9ba5;
}

/* 未开启引导卡片 */
.onboard-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 51, 56, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  text-align: center;
  margin-top: 20rpx;
}

.onboard-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(201, 74, 98, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.onboard-icon {
  font-size: 56rpx;
}

.onboard-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f272e;
  margin-bottom: 16rpx;
}

.onboard-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 36rpx;
  padding: 0 10rpx;
}

.feature-bullets {
  background: #f8fafc;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.bullet-item:last-child {
  margin-bottom: 0;
}

.bullet-icon {
  font-size: 32rpx;
  margin-top: 4rpx;
}

.bullet-content {
  flex: 1;
}

.bullet-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3338;
  display: block;
}

.bullet-sub {
  font-size: 22rpx;
  color: #8c9ba5;
  display: block;
  margin-top: 4rpx;
}

/* 二级导航 Tabs */
.sub-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  position: relative;
}

.tab-title-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tab-title {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.tab-badge {
  font-size: 18rpx;
  background: #c94a62;
  color: #ffffff;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}

.tab-active .tab-title {
  color: #c94a62;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 44rpx;
  height: 6rpx;
  background: #c94a62;
  border-radius: 4rpx;
}

/* 个人名片通用样式 */
.profile-card {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(44, 51, 56, 0.06);
  border: 1rpx solid rgba(226, 232, 240, 0.7);
  margin-bottom: 32rpx;
  position: relative;
}

.card-more-action {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  z-index: 10;
}

.more-dots {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

/* 封面大图 */
.photo-wrapper {
  position: relative;
  width: 100%;
  height: 520rpx;
  background: #e2e8f0;
}

.main-photo {
  width: 100%;
  height: 100%;
}

.photo-overlay-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8rpx);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.campus-pill {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  color: #334155;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.fate-match-tag {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #e55368, #c94a62);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(201, 74, 98, 0.4);
}

/* 资料正文区 */
.profile-info-body {
  padding: 30rpx 32rpx 20rpx;
}

.name-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.profile-nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e293b;
}

.profile-grade {
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.bio-text {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 共同兴趣突出 */
.shared-interests-row {
  background: #fdf2f4;
  border: 1rpx solid rgba(201, 74, 98, 0.2);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.shared-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #c94a62;
  margin-bottom: 10rpx;
  display: block;
}

.interests-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shared-chip {
  font-size: 24rpx;
  color: #c94a62;
  background: #ffffff;
  border: 1rpx solid rgba(201, 74, 98, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.normal-chip {
  font-size: 24rpx;
  color: #475569;
  background: #f1f5f9;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 最近想做的事 */
.looking-for-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #fffbeb;
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}

.looking-icon {
  font-size: 26rpx;
}

.looking-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.4;
  flex: 1;
}

/* 关联公开搭子 */
.recent-buddy-tile {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 10rpx;
}

.buddy-tile-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  overflow: hidden;
}

.buddy-tile-tag {
  font-size: 20rpx;
  color: #426089;
  background: rgba(66, 96, 137, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.buddy-tile-title {
  font-size: 24rpx;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.buddy-tile-btn {
  margin: 0;
  background: #ffffff;
  color: #426089;
  border: 1rpx solid rgba(66, 96, 137, 0.3);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 0 18rpx;
  line-height: 48rpx;
}

/* 底部操作行 */
.card-action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
}

.pass-btn {
  flex: 1;
  height: 88rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}

.like-btn {
  flex: 1.4;
  height: 88rpx;
  background: linear-gradient(135deg, #e55368, #c94a62);
  color: #ffffff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(201, 74, 98, 0.35);
  border: none;
  margin: 0;
}

.like-btn-icon {
  font-size: 32rpx;
}

.text-white {
  color: #ffffff;
}

/* 今日缘分卡容器 */
.fate-card-container {
  margin-top: 10rpx;
}

.quota-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
}

.quota-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.quota-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #c94a62;
  background: rgba(201, 74, 98, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.fate-box-unopened {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 36rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(44, 51, 56, 0.05);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.fate-gift-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.fate-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.fate-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.fate-draw-btn {
  width: 80%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #e55368, #c94a62);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(201, 74, 98, 0.35);
  margin: 0 auto;
}

.fate-box-mystery {
  background: linear-gradient(145deg, #ffffff, #fdf4f5);
  border: 2rpx solid rgba(201, 74, 98, 0.3);
  border-radius: 32rpx;
  padding: 50rpx 36rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(201, 74, 98, 0.12);
}

.mystery-sparkle {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.mystery-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f272e;
  margin-bottom: 24rpx;
}

.mystery-score-badge {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  background: #c94a62;
  color: #ffffff;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(201, 74, 98, 0.35);
}

.score-num {
  font-size: 40rpx;
  font-weight: 800;
}

.score-label {
  font-size: 22rpx;
  font-weight: 500;
}

.mystery-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.mystery-tip {
  font-size: 24rpx;
  color: #8c9ba5;
  margin-bottom: 36rpx;
}

/* 已匹配列表项 (Matches) */
.match-row-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
}

.match-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  overflow: hidden;
}

.match-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.match-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.match-grade {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.match-shared-summary {
  font-size: 24rpx;
  color: #8c9ba5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-chat-btn {
  margin: 0;
  background: #c94a62;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 28rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
  box-shadow: 0 4rpx 14rpx rgba(201, 74, 98, 0.3);
}

/* 匹配成功弹窗卡片 */
.match-celebration-card {
  background: linear-gradient(145deg, #ffffff, #fff5f6);
  border: 2rpx solid #c94a62;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(201, 74, 98, 0.15);
}

.celebration-badge {
  font-size: 36rpx;
  font-weight: 800;
  color: #c94a62;
  margin-bottom: 12rpx;
}

.celebration-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.celebration-shared {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

.celebration-actions {
  display: flex;
  gap: 18rpx;
}

.celebration-actions button {
  flex: 1;
  margin: 0;
}

/* 空状态卡片 */
.empty-state-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 70rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(44, 51, 56, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  margin-top: 20rpx;
}

.empty-emoji {
  font-size: 64rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8c9ba5;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

/* 按钮规范 */
.primary-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #e55368, #c94a62);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(201, 74, 98, 0.35);
  border: none;
}

.primary-btn-mini {
  background: #c94a62;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 28rpx;
  line-height: 60rpx;
  box-shadow: 0 4rpx 14rpx rgba(201, 74, 98, 0.3);
  margin: 0;
}

.outline-btn {
  background: #ffffff;
  color: #475569;
  border: 2rpx solid #cbd5e1;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 28rpx;
  line-height: 60rpx;
  margin: 0;
}

.secondary-btn {
  background: #f1f5f9;
  color: #475569;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 32rpx;
  line-height: 72rpx;
  margin: 20rpx auto;
}

.btn-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-hover-active {
  opacity: 0.9;
  transform: scale(0.985);
}

.btn-hover {
  opacity: 0.8;
}

/* 会员权益预览 */
.plus-preview-card {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-top: 40rpx;
  font-size: 24rpx;
}

.plus-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.plus-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.plus-tag {
  font-size: 18rpx;
  background: #e2e8f0;
  color: #64748b;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.plus-item {
  color: #475569;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.item-muted {
  color: #94a3b8;
}

.plus-note {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

/* 底部选项 */
.footer-options {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
}

.footer-link-btn {
  background: transparent;
  color: #426089;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
}

.footer-danger-btn {
  background: transparent;
  color: #94a3b8;
  font-size: 24rpx;
  border: none;
  padding: 8rpx 0;
  line-height: 1.4;
  margin: 0;
}
