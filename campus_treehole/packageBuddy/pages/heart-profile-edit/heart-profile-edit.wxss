page{background:#f6f7f8;color:#273536}.heart-page{padding:32rpx 28rpx 70rpx}.mode-tabs,.tabs,.actions{display:flex;gap:16rpx;align-items:center;margin:20rpx 0}.mode-tabs text{flex:1;text-align:center;padding:22rpx}.selected{color:#ca635b;border-bottom:4rpx solid #ca635b}.heading{font-size:40rpx;font-weight:600;margin-top:34rpx}.muted{color:#788281;font-size:26rpx;line-height:1.8;margin:16rpx 0}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin:28rpx 0;position:relative;line-height:1.8}.title{font-size:32rpx;font-weight:600;margin:12rpx 0}.photo{width:100%;height:330rpx;border-radius:18rpx}.tags{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.tags text{background:#f0f5f3;border-radius:12rpx;padding:4rpx 16rpx;font-size:24rpx}.primary{background:#ca635b;color:#fff}.actions button{font-size:26rpx;flex:1;padding:0 8rpx}button{margin-top:18rpx;font-size:28rpx;border-radius:16rpx}.more{position:absolute;right:38rpx;top:24rpx;z-index:1}.empty{padding:50rpx 15rpx;color:#788281;line-height:1.8}.notice{padding:20rpx;color:#b54238;background:#fff0ed;border-radius:14rpx}input,textarea,picker{padding:22rpx;background:#f6f7f8;border-radius:12rpx;margin:18rpx 0;box-sizing:border-box;width:100%}.checks{display:block;margin:26rpx 0;font-size:26rpx;line-height:1.8}.thumb{width:160rpx;height:180rpx;margin:8rpx;border-radius:12rpx}
