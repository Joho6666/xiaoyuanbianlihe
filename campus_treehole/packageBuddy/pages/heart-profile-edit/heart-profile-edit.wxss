/* packageBuddy/pages/heart-profile-edit/heart-profile-edit.wxss */
page {
  background-color: #f7f9fc;
  color: #2c3338;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.edit-container {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* 顶部引导区 */
.hero-section {
  padding: 20rpx 8rpx 32rpx;
}

.hero-badge {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  color: #c94a62;
  background: rgba(201, 74, 98, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f272e;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #6b7785;
  line-height: 1.6;
}

/* 错误提示条 */
.error-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fce8e6;
  border: 1rpx solid rgba(168, 56, 54, 0.2);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.error-icon {
  font-size: 28rpx;
}

.error-text {
  font-size: 26rpx;
  color: #a83836;
  flex: 1;
}

/* 表单卡片通用容器 */
.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(44, 51, 56, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f272e;
}

.section-tag {
  font-size: 20rpx;
  color: #c94a62;
  background: rgba(201, 74, 98, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.section-counter {
  font-size: 24rpx;
  color: #8c9ba5;
  font-weight: 500;
}

.section-tip {
  font-size: 24rpx;
  color: #8c9ba5;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 250rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef2f6;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  z-index: 10;
}

.delete-icon {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.photo-cover-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  padding: 8rpx 0 6rpx;
  font-weight: 500;
}

.photo-upload-slot {
  width: 200rpx;
  height: 250rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #cbd5e1;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #426089;
}

.upload-sub {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.slot-hover {
  background: #edf2f7;
  border-color: #426089;
}

/* 字段组 */
.field-group {
  margin-top: 24rpx;
}

.field-group:first-child {
  margin-top: 0;
}

.field-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3338;
  margin-bottom: 12rpx;
  display: block;
}

.field-counter {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 分段式选择胶囊 (Pills) */
.pill-group {
  display: flex;
  gap: 16rpx;
}

.pill-item {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #f1f5f9;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  transition: all 0.2s ease;
}

.pill-item.pill-active {
  background: rgba(201, 74, 98, 0.08);
  border-color: #c94a62;
  color: #c94a62;
  font-weight: 700;
}

.pill-check {
  font-size: 24rpx;
  color: #c94a62;
  font-weight: bold;
}

.pill-icon {
  font-size: 32rpx;
}

/* 输入框规范 */
.input-container {
  width: 100%;
}

.modern-input {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f272e;
  box-sizing: border-box;
}

.modern-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f272e;
  line-height: 1.5;
  box-sizing: border-box;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

/* 快捷 Chips 标签 */
.quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip-item {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.chip-item.chip-active {
  background: rgba(201, 74, 98, 0.1);
  color: #c94a62;
  border-color: rgba(201, 74, 98, 0.3);
  font-weight: 600;
}

/* 已选兴趣展示区 */
.selected-tags-box {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  background: #fdf2f4;
  border: 1rpx dashed rgba(201, 74, 98, 0.35);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  border: 1rpx solid rgba(201, 74, 98, 0.3);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(201, 74, 98, 0.08);
}

.tag-name {
  font-size: 24rpx;
  color: #c94a62;
  font-weight: 600;
}

.tag-remove {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: bold;
  padding: 0 4rpx;
}

.preset-label {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 自定义兴趣输入行 */
.custom-tag-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  align-items: center;
}

.custom-tag-input {
  flex: 1;
  height: 76rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.custom-add-btn {
  height: 76rpx;
  line-height: 76rpx;
  background: #426089;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin: 0;
}

/* 授权与合规卡片条目 */
.consent-card {
  padding-bottom: 24rpx;
}

.consent-tile {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 22rpx;
  margin-bottom: 18rpx;
  align-items: flex-start;
  transition: all 0.2s ease;
}

.consent-tile.consent-tile-active {
  background: #fffbfa;
  border-color: rgba(201, 74, 98, 0.35);
}

.custom-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.custom-checkbox.checked {
  background: #c94a62;
  border-color: #c94a62;
}

.consent-text-wrap {
  flex: 1;
}

.consent-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f272e;
  margin-bottom: 6rpx;
}

.consent-sub {
  font-size: 22rpx;
  color: #718096;
  line-height: 1.5;
}

.privacy-note {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2f7;
}

.note-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.note-content {
  font-size: 22rpx;
  color: #8c9ba5;
  line-height: 1.6;
}

/* 底部固定操作栏 */
.bottom-bar-placeholder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  border-top: 1rpx solid #eef2f6;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #e55368, #c94a62);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(201, 74, 98, 0.35);
  border: none;
}

.btn-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-hover-active {
  opacity: 0.9;
  transform: scale(0.985);
}

.btn-hover {
  opacity: 0.8;
}
