<campus-page-header title="订单详情" subtitle="订单状态与配送信息" showBack="{{true}}" bindback="onBack" />
<view class="express-page" wx:if="{{order}}"><view class="express-hero"><text class="express-title">{{order.orderNo}}</text><text class="express-chip {{order.tone}}">{{order.statusLabel}}</text></view><view class="express-card"><text class="express-section-title">取件信息</text><text class="express-order-meta">{{order.pickupPointNameSnapshot || order.pickupPointName}} · 取件码 {{order.pickupCode || '提交后由工作人员查看'}}</text><text class="express-order-meta">{{order.packageCount}} 件 · ￥{{order.priceText}}</text><text class="express-order-meta">{{order.deliveryCampusNameSnapshot || order.deliveryCampus}} · {{order.dormAreaNameSnapshot || order.dormArea}} · {{order.dormBuildingNameSnapshot || order.dormBuilding}} · {{order.roomNumber}}</text><text class="express-order-meta">联系电话 {{order.phone}}</text><text class="express-order-meta">支付状态：{{order.paymentLabel}}</text></view><view class="express-card" wx:if="{{order.paymentStatus === 'UNPAID' && settings.testPaymentAvailable}}"><text class="express-section-title">独立测试环境</text><text class="express-note">当前是测试支付适配器，不会产生真实扣款。</text><view class="express-button" bindtap="onTestPay">{{paying ? '处理中…' : '测试支付 ￥' + order.priceText}}</view><view class="express-button muted" bindtap="onCancel">{{cancelling ? '取消中…' : '取消订单'}}</view></view><view class="express-empty" wx:if="{{order.paymentStatus === 'UNPAID' && !settings.testPaymentAvailable}}"><text class="express-empty-title">等待支付</text><text class="express-empty-desc">真实支付尚未接入，请勿向任何人转账</text><view class="express-button muted" bindtap="onCancel">取消订单</view></view></view>
