<campus-page-header title="订单详情" subtitle="查看每个快递点的取件信息" showBack="{{true}}" bindback="onBack" />
<view class="express-page" wx:if="{{order}}">
  <view class="express-hero"><text class="express-title">{{order.orderNo}}</text><text class="express-chip {{order.tone}}">{{order.statusLabel}}</text></view>
  <view class="express-card mismatch-alert-card" wx:if="{{order.parcelSizeMismatch}}">
    <view class="mismatch-alert-title"><text class="mismatch-icon">⚠️</text><text>规格核验提示</text></view>
    <text class="mismatch-alert-desc">工作人员核验：包裹规格与下单选择不一致，请联系工作人员。</text>
  </view>
  <view class="express-card"><view class="detail-section-head"><text class="express-section-title">取件信息</text><text class="detail-summary">{{order.totalPackageCount || order.packageCount}} 件 · {{order.pickupPointCount || 1}} 个快递点</text></view><view class="detail-pickup-group" wx:for="{{order.pickupItems}}" wx:key="id" wx:for-item="pickupItem"><view class="detail-pickup-point">{{pickupItem.pickupPointNameSnapshot || pickupItem.pickupPointId}}</view><view class="detail-pickup-row"><text class="detail-pickup-label">取件码</text><text class="detail-pickup-code">{{pickupItem.pickupCode}}</text><text class="detail-pickup-count">{{pickupItem.packageCount}} 件 · {{pickupItem.parcelSizeLabel}}</text></view></view></view>
  <view class="express-card"><text class="express-section-title">配送信息</text><text class="express-order-meta">送给 {{order.recipientNameSnapshot || '未填写'}}</text><text class="express-order-meta">{{order.deliveryCampusNameSnapshot || order.deliveryCampus}} · {{order.dormAreaNameSnapshot || order.dormArea}} · {{order.dormBuildingNameSnapshot || order.dormBuilding}} · {{order.roomNumberSnapshot || order.roomNumber}}</text><text class="express-order-meta">联系电话 {{order.recipientPhoneSnapshot || order.phone}}</text><text class="express-order-meta">服务费 ￥{{order.priceText}}</text><text class="express-order-meta">支付状态：{{order.paymentLabel}}</text></view>
  <view class="express-card" wx:if="{{order.paymentStatus === 'UNPAID' && settings.testPaymentAvailable}}"><text class="express-section-title">独立测试环境</text><text class="express-note">当前是测试支付适配器，不会产生真实扣款。</text><view class="express-button" bindtap="onTestPay">{{paying ? '处理中…' : '测试支付 ￥' + order.priceText}}</view><view class="express-button muted" bindtap="onCancel">{{cancelling ? '取消中…' : '取消订单'}}</view></view>
  <view class="express-empty" wx:if="{{order.paymentStatus === 'UNPAID' && !settings.testPaymentAvailable}}"><text class="express-empty-title">等待支付</text><text class="express-empty-desc">真实支付尚未接入，请勿向任何人转账</text><view class="express-button muted" bindtap="onCancel">取消订单</view></view>
</view>
