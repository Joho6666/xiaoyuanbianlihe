<campus-page-header title="我的快递" subtitle="只显示你自己的订单" showBack="{{true}}" bindback="onBack" />
<view class="express-page"><view class="express-card" wx:if="{{orders.length}}"><view class="express-order-row" wx:for="{{orders}}" wx:key="_id" bindtap="onTapOrder" data-id="{{item._id}}"><view class="express-order-main"><text class="express-order-no">{{item.orderNo}}</text><text class="express-order-meta">{{item.pickupPointName}} · {{item.packageCount}} 件 · {{item.dormBuilding}} {{item.roomNumber}}</text><text class="express-order-meta">送给 {{item.recipientNameSnapshot || '未填写'}}</text><text class="express-chip {{item.tone}}">{{item.statusLabel}}</text></view><text class="express-order-price">￥{{item.priceText}}</text></view></view><view class="express-empty" wx:else><text class="express-empty-title">还没有快递订单</text><text class="express-empty-desc">需要代拿时，从首页快递入口开始</text></view></view>
