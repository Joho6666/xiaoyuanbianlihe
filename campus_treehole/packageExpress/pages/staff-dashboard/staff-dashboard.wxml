<campus-page-header title="快递工作台" subtitle="手机上也能看清每一单" showBack="{{true}}" bindback="onBack" />
<view class="express-page" wx:if="{{authorized}}"><view class="express-hero"><text class="express-title">今日订单</text><text class="express-subtitle">{{dashboard.campusId}} · {{dashboard.acceptingOrders ? '正在接单' : '暂不接单'}}</text></view><view class="express-card"><view class="express-grid"><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.waitPickup}}</text><text class="express-stat-label">待取件订单</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.delivering}}</text><text class="express-stat-label">配送中</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.completed}}</text><text class="express-stat-label">已完成</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.all}}</text><text class="express-stat-label">全部订单</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.totalPackageCount}}</text><text class="express-stat-label">总包裹数</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.pickupItemCount}}</text><text class="express-stat-label">取件码数</text></view><view class="express-stat"><text class="express-stat-number">{{dashboard.counts.pickupPointCount}}</text><text class="express-stat-label">快递点数</text></view><view class="express-stat"><text class="express-stat-number">￥{{dashboard.counts.revenueText}}</text><text class="express-stat-label">已支付金额</text></view></view></view><view class="express-card"><view class="express-button" bindtap="openOrders">查看订单</view><view class="express-button muted" bindtap="openExport">导出 Excel</view><view class="express-button muted" wx:if="{{capabilities.isOwner}}" bindtap="openSettings">快递服务设置</view><view class="express-button muted" wx:if="{{capabilities.isOwner}}" bindtap="openManagement">工作人员管理</view></view></view><view class="express-empty" wx:else><text class="express-empty-title">无权限</text><text class="express-empty-desc">工作人员权限已由服务端确认</text></view>
