<campus-page-header title="导出订单" subtitle="文件只保留 7 天，请妥善处理" showBack="{{true}}" bindback="onBack" /><view class="express-page"><view class="express-card"><text class="express-section-title">导出条件</text><text class="express-label">状态</text><picker class="express-picker" range="{{statusOptions}}" bindchange="onStatusChange"><view>{{statusOptions[statusIndex]}}　›</view></picker><text class="express-label">校区</text><text class="express-note">当前授权校区：{{campusId}}</text><view class="express-button" bindtap="onExport">{{exporting ? '生成中…' : '生成 Excel'}}</view></view><view class="express-card" wx:if="{{fileId}}"><text class="express-section-title">文件已生成</text><text class="express-note">共 {{orderCount}} 单，文件为私有临时文件。</text><view class="express-button muted" bindtap="openFile">打开文件</view></view></view>
