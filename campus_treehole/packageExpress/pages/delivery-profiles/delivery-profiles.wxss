@import "../../common.wxss";
.profile-page { min-height: 100vh; padding: 24rpx 28rpx 70rpx; box-sizing: border-box; background: #f3f7fd; }
.profile-tip { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 22rpx; margin-bottom: 20rpx; border-radius: 22rpx; color: #55708f; background: #eaf3ff; font-size: 23rpx; line-height: 1.4; }
.profile-tip-icon { display: flex; width: 34rpx; height: 34rpx; align-items: center; justify-content: center; border-radius: 50%; color: #2f76ff; background: #fff; font-size: 24rpx; font-weight: 700; }
.profile-tabs { display: flex; gap: 8rpx; padding: 8rpx; margin-bottom: 22rpx; border-radius: 20rpx; background: #e8f0fb; }
.profile-tab { flex: 1; padding: 16rpx; border-radius: 16rpx; color: #71809a; text-align: center; font-size: 25rpx; }
.profile-tab.active { color: #fff; background: #2f76ff; box-shadow: 0 8rpx 20rpx rgba(47,118,255,.18); }
.profile-section-title { display: flex; justify-content: space-between; align-items: center; margin: 8rpx 2rpx 16rpx; color: #172033; font-size: 30rpx; font-weight: 700; }
.profile-count { color: #95a3b7; font-size: 22rpx; font-weight: 500; }
.profile-card { padding: 24rpx; margin-bottom: 16rpx; border: 2rpx solid transparent; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(55,91,145,.08); }
.profile-card.selected { border-color: #2f76ff; background: #fafdff; }
.profile-card-top { display: flex; align-items: center; }
.profile-avatar { display: flex; width: 70rpx; height: 70rpx; align-items: center; justify-content: center; margin-right: 16rpx; border-radius: 22rpx; color: #2f76ff; background: #eaf3ff; font-size: 27rpx; font-weight: 700; }
.profile-card-main { flex: 1; min-width: 0; }
.profile-name-row { display: flex; align-items: center; gap: 10rpx; }
.profile-label { color: #172033; font-size: 29rpx; font-weight: 700; }
.default-chip { padding: 5rpx 10rpx; border-radius: 999rpx; color: #2f76ff; background: #eaf3ff; font-size: 20rpx; }
.profile-recipient { display: block; margin-top: 5rpx; color: #6f7f98; font-size: 23rpx; }
.profile-radio { color: #b7c2d2; font-size: 38rpx; }
.profile-radio.checked { color: #2f76ff; }
.profile-address, .profile-phone { display: block; margin-top: 16rpx; color: #43536b; font-size: 24rpx; line-height: 1.45; }
.profile-phone { margin-top: 8rpx; color: #8a98ab; font-size: 23rpx; }
.profile-actions { display: flex; gap: 12rpx; padding-top: 18rpx; margin-top: 18rpx; border-top: 2rpx solid #f0f3f8; }
.profile-action { flex: 1; padding: 13rpx 8rpx; border: 2rpx solid #e3eaf4; border-radius: 16rpx; color: #55708f; text-align: center; font-size: 22rpx; }
.profile-action.danger { color: #d34f62; border-color: #f7dde1; }
.profile-empty { padding: 90rpx 24rpx 70rpx; text-align: center; }
.profile-empty-icon { display: block; color: #8bb8ff; font-size: 70rpx; }
.profile-empty-title { display: block; margin-top: 18rpx; color: #30405a; font-size: 29rpx; font-weight: 700; }
.profile-empty-desc { display: block; margin-top: 10rpx; color: #8795aa; font-size: 24rpx; }
.profile-add { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 82rpx; border: 2rpx solid #2f76ff; border-radius: 22rpx; color: #2f76ff; background: #fff; font-size: 27rpx; font-weight: 600; }
.profile-add-icon { font-size: 38rpx; font-weight: 400; }
.profile-note { margin-top: 18rpx; color: #9aa6b8; text-align: center; font-size: 21rpx; }
