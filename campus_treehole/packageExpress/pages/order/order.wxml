<campus-page-header title="快递代拿" subtitle="填写一次，之后下单自动带入" showBack="{{true}}" bindback="onBack" />
<view class="express-page">
  <view class="express-hero express-order-hero"><view><text class="express-title">快递代拿</text><text class="express-subtitle">{{settings.cutoffTime ? '今日 ' + settings.cutoffTime + ' 截单' : '校内专人配送'}} · {{settings.deliveryWindow || '状态可查'}}</text></view><view class="order-hero-mark">▣</view></view>
  <view class="express-empty express-config-error" wx:if="{{loadError}}"><text class="express-empty-title">服务配置加载失败</text><text class="express-empty-desc">{{loadErrorMsg || '请检查网络后重试，暂未创建订单'}}</text><view class="express-button muted" bindtap="onRetry">重新加载</view></view>
  <view class="express-card" wx:elif="{{settings.acceptingOrders}}">
    <view class="order-section"><text class="express-section-title">① 取件信息</text><text class="express-label">取件点</text><picker class="express-picker" range="{{settings.pickupPoints}}" range-key="name" bindchange="onPointChange"><view>{{selectedPointName || '请选择快递点'}} <text class="picker-arrow">›</text></view></picker><text class="express-label">取件码</text><input class="express-input" value="{{form.pickupCode}}" placeholder="例如 2-3-4587" maxlength="40" data-key="pickupCode" bindinput="onInput" /><text class="express-label">包裹数量</text><view class="count-stepper"><view class="count-button" data-delta="-1" bindtap="adjustCount">−</view><text>{{form.packageCount}}</text><view class="count-button" data-delta="1" bindtap="adjustCount">＋</view></view></view>
    <view class="order-section"><view class="profile-section-head"><text class="express-section-title">② 送给谁</text><view class="profile-switch-link" bindtap="onChooseProfile">切换配送信息 ›</view></view><view class="selected-profile" wx:if="{{selectedProfile}}"><view class="selected-profile-top"><view class="selected-profile-icon">{{selectedProfile.isSelf ? '我' : '友'}}</view><view><text class="selected-profile-label">{{selectedProfile.label}}</text><text class="selected-profile-name">{{selectedProfile.recipientName}}</text></view><text class="selected-profile-default" wx:if="{{selectedProfile.isDefault}}">默认</text></view><text class="selected-profile-address">{{selectedProfile.deliveryCampusName}} · {{selectedProfile.dormAreaName}} · {{selectedProfile.dormBuildingName}} · {{selectedProfile.roomNumber}}</text><text class="selected-profile-phone">{{selectedProfile.maskedPhone}}</text></view><view class="profile-prompt" wx:else><text class="profile-prompt-title">还没有常用配送信息</text><text class="profile-prompt-desc">填写一次，以后下单会自动带入</text><view class="express-button muted" bindtap="onAddProfile">添加我的宿舍</view></view><view class="migration-prompt" wx:if="{{showCacheMigration}}"><text>检测到你之前填写的配送信息</text><text class="migration-sub">确认后保存为账号资料，换手机也能使用</text><view class="migration-action" bindtap="onMigrateCache">保存为我的宿舍</view></view></view>
    <view class="order-section order-note-section"><text class="express-label">备注（选填）</text><textarea class="express-textarea" value="{{form.note}}" maxlength="100" placeholder="补充取件或配送说明" data-key="note" bindinput="onInput" /></view>
    <view class="order-submit-bar"><view><text class="order-total-label">服务费</text><text class="order-total">{{quote ? '￥' + quote.totalPrice : '选择快递点后报价'}}</text></view><view class="express-button order-submit" bindtap="onSubmit">{{submitting ? '提交中…' : (quote && settings.testPaymentAvailable ? '提交并进入测试支付' : '提交订单')}}</view></view>
  </view>
  <view class="express-empty" wx:else><text class="express-empty-title">{{settings.configured ? '今日暂停接单' : '服务尚未配置'}}</text><text class="express-empty-desc">{{settings.configured ? '工作人员恢复接单后，你可以在这里提交取件信息' : '请 Owner 在快递服务设置中配置接单状态、快递点和宿舍'}}</text></view>
</view>
