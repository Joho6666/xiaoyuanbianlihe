<campus-page-header title="快递代拿" subtitle="填写取件信息，工作人员会尽快处理" showBack="{{true}}" bindback="onBack" />
<view class="express-page">
  <view class="express-hero express-order-hero"><view><text class="express-title">快递代拿</text><text class="express-subtitle">{{settings.cutoffTime ? '今日 ' + settings.cutoffTime + ' 截单' : '校内专人配送'}} · {{settings.deliveryWindow || '状态可查'}}</text></view><view class="order-hero-mark">▣</view></view>
  <view class="express-card" wx:if="{{settings.acceptingOrders}}">
    <view class="order-section"><text class="express-section-title">① 取件信息</text><text class="express-label">取件点</text><picker class="express-picker" range="{{settings.pickupPoints}}" range-key="name" bindchange="onPointChange"><view>{{selectedPointName || '请选择快递点'}} <text class="picker-arrow">›</text></view></picker><text class="express-label">取件码</text><input class="express-input" placeholder="例如 2-3-4587" maxlength="40" data-key="pickupCode" bindinput="onInput" /><text class="express-label">包裹数量</text><view class="count-stepper"><view class="count-button" data-delta="-1" bindtap="adjustCount">−</view><text>{{form.packageCount}}</text><view class="count-button" data-delta="1" bindtap="adjustCount">＋</view></view></view>
    <view class="order-section"><text class="express-section-title">② 送到哪里</text><text class="express-label">配送校区</text><picker class="express-picker" range="{{settings.deliveryCampuses}}" range-key="name" bindchange="onCampusChange"><view>{{selectedCampusName || '请选择南校区 / 北校区'}} <text class="picker-arrow">›</text></view></picker><text class="express-label">宿舍园区</text><picker class="express-picker" range="{{areaOptions}}" range-key="name" bindchange="onAreaChange"><view>{{selectedAreaName || '请选择宿舍园区'}} <text class="picker-arrow">›</text></view></picker><text class="express-label">楼栋</text><picker class="express-picker" range="{{buildingOptions}}" range-key="name" bindchange="onBuildingChange"><view>{{selectedBuildingName || '请选择楼栋'}} <text class="picker-arrow">›</text></view></picker><text class="express-label">房间号</text><input class="express-input" placeholder="例如 613" maxlength="20" data-key="roomNumber" bindinput="onInput" /><text class="express-label">联系电话</text><input class="express-input" type="number" maxlength="11" placeholder="用于配送联系" data-key="phone" bindinput="onInput" /></view>
    <view class="order-section order-note-section"><text class="express-label">备注（选填）</text><textarea class="express-textarea" maxlength="100" placeholder="补充取件或配送说明" data-key="note" bindinput="onInput" /></view>
    <view class="order-submit-bar"><view><text class="order-total-label">服务费</text><text class="order-total">{{quote ? '￥' + quote.totalPrice : '选择快递点后报价'}}</text></view><view class="express-button order-submit" bindtap="onSubmit">{{submitting ? '提交中…' : (quote && settings.testPaymentAvailable ? '提交并进入测试支付' : '提交订单')}}</view></view>
  </view>
  <view class="express-empty" wx:else><text class="express-empty-title">当前校区暂未开放快递代拿</text><text class="express-empty-desc">服务开启后，你可以在这里提交取件信息</text></view>
</view>
