<campus-page-header title="快递代拿" subtitle="填写取件信息，今晚送到宿舍" showBack="{{true}}" bindback="onBack" />
<view class="express-page">
  <view class="express-mini-hero">
    <view><text class="express-title">桂航专人配送</text><text class="express-subtitle">{{settings.cutoffTime ? '今日 ' + settings.cutoffTime + ' 截单' : '校内专人配送'}} · {{settings.deliveryWindow || '状态可查'}}</text></view>
    <view class="order-hero-mark">▣</view>
  </view>
  <view class="express-empty express-config-error" wx:if="{{loadError}}"><text class="express-empty-title">服务配置加载失败</text><text class="express-empty-desc">{{loadErrorMsg || '请检查网络后重试，暂未创建订单'}}</text><view class="express-button muted" bindtap="onRetry">重新加载</view></view>
  <view class="express-card" wx:elif="{{settings.acceptingOrders}}">
    <view class="order-section">
      <view class="section-title-row"><text class="express-section-title">① 取件信息</text><text class="section-caption">支持多个快递点</text></view>
      <view class="pickup-group" wx:for="{{pickupGroups}}" wx:key="groupKey" wx:for-item="group" wx:for-index="groupIndex">
        <view class="pickup-group-head"><picker class="pickup-point-picker" range="{{settings.pickupPoints}}" range-key="name" value="{{group.pointIndex}}" data-group-index="{{groupIndex}}" bindchange="onGroupPointChange"><view><text class="pickup-point-icon">▣</text><text>{{group.pickupPointName || '请选择快递点'}}</text><text class="picker-arrow">›</text></view></picker><text class="pickup-group-count">{{group.items.length}} 个取件码</text></view>
        <view class="pickup-item" wx:for="{{group.items}}" wx:key="id" wx:for-item="pickupItem" wx:for-index="itemIndex"><input class="express-input pickup-code-input" value="{{pickupItem.pickupCode}}" focus="{{pickupItem.focus}}" placeholder="请输入取件码" maxlength="40" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" bindinput="onPickupInput" bindfocus="onPickupFocus" bindblur="onPickupBlur" bindconfirm="onPickupConfirm" /><view class="parcel-size-row"><text class="parcel-size-label">包裹规格</text><view class="parcel-size-options"><view class="parcel-size-option {{pickupItem.parcelSize === option.value ? 'active' : ''}}" wx:for="{{parcelSizeOptions}}" wx:key="value" wx:for-item="option" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" data-size="{{option.value}}" bindtap="onParcelSizeTap"><text>{{option.label}}</text><text>{{option.priceText}}</text></view></view></view><view class="item-stepper"><view class="item-step" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" data-delta="-1" bindtap="onItemCountChange">−</view><text>{{pickupItem.packageCount}} 件</text><view class="item-step" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" data-delta="1" bindtap="onItemCountChange">＋</view></view><text class="pickup-remove" data-group-index="{{groupIndex}}" data-item-index="{{itemIndex}}" catchtap="removePickupItem">×</text></view>
        <view class="add-code" data-group-index="{{groupIndex}}" bindtap="addPickupCode">＋ 添加取件码</view>
      </view>
      <view class="add-point" bindtap="addPickupPoint">＋ 添加其他快递站</view>
      <view class="screenshot-import-entry" bindtap="onImportScreenshots"><view class="screenshot-import-icon">▧</view><view class="screenshot-import-copy"><text class="screenshot-import-title">截图一键导入</text><text class="screenshot-import-desc">上传快递通知截图，自动识别取件码</text></view><text class="screenshot-import-arrow">›</text></view>
      <text class="import-stage" wx:if="{{importing}}">{{importStage}}</text>
      <text class="inline-error" wx:if="{{inlineErrors.pickup}}">{{inlineErrors.pickup}}</text>
    </view>
    <view class="order-section">
      <view class="section-title-row"><text class="express-section-title">② 送到哪里</text><text class="profile-switch-link" wx:if="{{selectedProfile}}" bindtap="onChooseProfile">更换 ›</text></view>
      <view class="selected-profile" wx:if="{{selectedProfile}}"><view class="selected-profile-top"><view class="selected-profile-icon">{{selectedProfile.isSelf ? '我' : '友'}}</view><view><text class="selected-profile-label">{{selectedProfile.label}}</text><text class="selected-profile-name">{{selectedProfile.recipientName}}</text></view><text class="selected-profile-default" wx:if="{{selectedProfile.isDefault}}">默认</text></view><text class="selected-profile-address">{{selectedProfile.deliveryCampusName}} · {{selectedProfile.dormAreaName}} · {{selectedProfile.dormBuildingName}} · {{selectedProfile.roomNumber}}</text><text class="selected-profile-phone">{{selectedProfile.maskedPhone}}</text></view>
      <view class="inline-profile-editor" wx:else id="delivery-error">
        <view class="mode-tabs"><view class="mode-tab {{deliveryMode === 'self' ? 'active' : ''}}" data-mode="self" bindtap="onDeliveryModeChange">我自己</view><view class="mode-tab {{deliveryMode === 'other' ? 'active' : ''}}" data-mode="other" bindtap="onDeliveryModeChange">其他人</view></view>
        <text class="express-label">姓名</text><input class="express-input" value="{{deliveryForm.recipientName}}" placeholder="请输入收件人姓名" data-key="recipientName" bindinput="onDeliveryInput" /><text class="inline-error" wx:if="{{inlineErrors.recipientName}}">{{inlineErrors.recipientName}}</text>
        <text class="express-label">手机号</text><input class="express-input" value="{{deliveryForm.contactPhone}}" type="number" placeholder="请输入联系电话" data-key="contactPhone" bindinput="onDeliveryInput" /><text class="inline-error" wx:if="{{inlineErrors.contactPhone}}">{{inlineErrors.contactPhone}}</text>
        <text class="express-label">配送校区</text><picker class="express-picker" range="{{settings.deliveryCampuses}}" range-key="name" bindchange="onDeliveryCampusChange"><view>{{deliveryForm.deliveryCampusName || '请选择南校区 / 北校区'}} <text class="picker-arrow">›</text></view></picker><text class="inline-error" wx:if="{{inlineErrors.deliveryCampus}}">{{inlineErrors.deliveryCampus}}</text>
        <text class="express-label">宿舍园区</text><picker class="express-picker" range="{{areaOptions}}" range-key="name" bindchange="onDeliveryAreaChange"><view>{{deliveryForm.dormAreaName || '请选择宿舍园区'}} <text class="picker-arrow">›</text></view></picker><text class="inline-error" wx:if="{{inlineErrors.dormArea}}">{{inlineErrors.dormArea}}</text>
        <text class="express-label">楼栋</text><picker class="express-picker" range="{{buildingOptions}}" range-key="name" bindchange="onDeliveryBuildingChange"><view>{{deliveryForm.dormBuildingName || '请选择楼栋'}} <text class="picker-arrow">›</text></view></picker><text class="inline-error" wx:if="{{inlineErrors.dormBuildingId}}">{{inlineErrors.dormBuildingId}}</text>
        <text class="express-label">房间号</text><input class="express-input" value="{{deliveryForm.roomNumber}}" placeholder="例如 613" data-key="roomNumber" bindinput="onDeliveryInput" /><text class="inline-error" wx:if="{{inlineErrors.roomNumber}}">{{inlineErrors.roomNumber}}</text>
        <view class="save-profile-row" wx:if="{{deliveryMode === 'other'}}"><checkbox value="save" checked="{{saveDeliveryProfile}}" bindchange="onSaveDeliveryChange" color="#2f76ff" /><text>保存为常用配送信息</text></view>
      </view>
    </view>
    <view class="order-section order-note-section"><text class="express-label">备注（选填）</text><textarea class="express-textarea" value="{{form.note}}" maxlength="100" placeholder="补充取件或配送说明" data-key="note" bindinput="onInput" /></view>
    <view class="order-submit-bar"><view><text class="order-total-label">{{quote ? '共' + quote.totalPackageCount + '件 · ' + quote.pickupPointCount + '个快递点' : '服务费'}}</text><text class="order-total">{{quote ? '￥' + quote.totalPrice : '选择快递点后报价'}}</text></view><view class="express-button order-submit" bindtap="onSubmit">{{submitting ? '提交中…' : (quote && settings.testPaymentAvailable ? '提交并进入测试支付' : '提交订单')}}</view></view>
  </view>
  <view class="express-empty" wx:if="{{!settings.acceptingOrders && !loadError}}"><text class="express-empty-title">{{settings.configured ? '今日暂停接单' : '服务尚未配置'}}</text><text class="express-empty-desc">{{settings.configured ? '工作人员恢复接单后，你可以在这里提交取件信息' : '请 Owner 在快递服务设置中配置接单状态、快递点和宿舍'}}</text></view>
  <view class="profile-sheet-mask" wx:if="{{showProfileSheet}}" catchtap="closeProfileSheet"><view class="profile-sheet" catchtap="stopPropagation"><view class="profile-sheet-head"><text>选择配送信息</text><text bindtap="closeProfileSheet">×</text></view><view class="sheet-mode-tabs"><view class="sheet-mode-tab {{profileFilter === 'self' ? 'active' : ''}}" data-mode="self" bindtap="onProfileFilterChange">给自己</view><view class="sheet-mode-tab {{profileFilter === 'other' ? 'active' : ''}}" data-mode="other" bindtap="onProfileFilterChange">帮别人</view></view><view class="sheet-profile-row" wx:for="{{visibleProfiles}}" wx:key="_id" bindtap="onSelectProfile" data-id="{{item._id}}"><view><text class="sheet-profile-label">{{item.label}}</text><text class="sheet-profile-meta">{{item.recipientName}} · {{item.maskedPhone}}</text><text class="sheet-profile-address">{{item.deliveryCampusName}} · {{item.dormAreaName}} · {{item.dormBuildingName}} · {{item.roomNumber}}</text></view><text class="sheet-check">{{item._id === (selectedProfile && selectedProfile._id) ? '✓' : '○'}}</text></view><view class="sheet-add" bindtap="onNewInlineProfile">＋ 新增配送信息</view></view></view>
  <view class="profile-sheet-mask" wx:if="{{showImportSheet}}" catchtap="closeImportSheet"><view class="profile-sheet import-sheet" catchtap="stopPropagation"><view class="profile-sheet-head"><text>确认识别结果</text><text bindtap="closeImportSheet">×</text></view><text class="import-summary">已识别 {{importSummary.candidateCount}} 条取件信息{{importSummary.duplicateCount ? '，去重 ' + importSummary.duplicateCount + ' 条' : ''}}</text><view class="import-failed" wx:if="{{importFailedImages.length}}"><text>有 {{importFailedImages.length}} 张截图识别失败，可重新选择。</text><view class="sheet-add" bindtap="retryImportScreenshots">重新选择截图</view></view><view class="import-candidate" wx:for="{{importCandidates}}" wx:key="id" wx:for-item="candidate" wx:for-index="candidateIndex"><view class="import-candidate-head"><text>截图 {{candidate.sourceImageIndex}}</text><text class="import-status {{candidate.matchStatus === 'MATCHED' ? 'matched' : 'review'}}">{{candidate.matchStatus === 'MATCHED' ? '已匹配' : '需确认快递点'}}</text><text class="import-remove" data-index="{{candidateIndex}}" catchtap="removeImportCandidate">删除</text></view><input class="express-input" value="{{candidate.pickupCode}}" data-index="{{candidateIndex}}" data-key="pickupCode" bindinput="onImportCandidateInput" /><picker class="express-picker import-point-picker" range="{{settings.pickupPoints}}" range-key="name" value="{{candidate.pointIndex < 0 ? 0 : candidate.pointIndex}}" data-index="{{candidateIndex}}" bindchange="onImportPointChange"><view>{{candidate.pickupPointName || '请选择快递点'}} <text class="picker-arrow">›</text></view></picker><view class="import-size-row"><text>包裹规格</text><view class="import-size-options"><view class="import-size-option {{candidate.parcelSize === option.value ? 'active' : ''}}" wx:for="{{parcelSizeOptions}}" wx:key="value" wx:for-item="option" data-index="{{candidateIndex}}" data-size="{{option.value}}" bindtap="onImportSizeTap"><text>{{option.label}}</text><text>{{option.priceText}}</text></view></view></view><view class="import-count"><text>包裹件数</text><view class="item-stepper"><view class="item-step" data-index="{{candidateIndex}}" data-delta="-1" bindtap="onImportCountChange">−</view><text>{{candidate.packageCount}} 件</text><view class="item-step" data-index="{{candidateIndex}}" data-delta="1" bindtap="onImportCountChange">＋</view></view></view><text class="import-warning" wx:if="{{candidate.warnings.length || !candidate.parcelSize}}">请核对快递点、规格和件数后再导入</text></view><view class="import-empty" wx:if="{{!importCandidates.length}}">未识别到取件码，请重新选择清晰截图。</view><view class="sheet-add" bindtap="confirmImport">全部导入到下单页</view></view></view>
</view>
