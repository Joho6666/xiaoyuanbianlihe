<campus-page-header title="订单管理" subtitle="只显示当前授权校区" showBack="{{true}}" bindback="onBack" />
<view class="express-page">
  <input class="express-input" placeholder="搜索订单号、取件码、手机号或房间" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm" />
  <view class="express-toolbar">
    <view class="express-filter {{activeStatus === '' ? 'active' : ''}}" data-status="" bindtap="onFilter">全部</view>
    <view class="express-filter {{activeStatus === 'WAIT_PICKUP' ? 'active' : ''}}" data-status="WAIT_PICKUP" bindtap="onFilter">待取件</view>
    <view class="express-filter {{activeStatus === 'DELIVERING' ? 'active' : ''}}" data-status="DELIVERING" bindtap="onFilter">配送中</view>
    <view class="express-filter {{activeStatus === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="onFilter">已完成</view>
  </view>
  <view class="express-card" wx:if="{{orders.length}}">
    <view class="express-order-row" wx:for="{{orders}}" wx:key="_id" bindtap="onTapOrder" data-id="{{item._id}}">
      <view class="express-order-main"><text class="express-order-no">{{item.pickupPointName}} · {{item.pickupCode}}</text><text class="express-order-meta">{{item.packageCount}} 件 · {{item.dormBuilding}} {{item.roomNumber}} · {{item.phone}}</text><text class="express-chip {{item.tone}}">{{item.statusLabel}}</text></view>
      <text class="express-order-price">{{item.orderNo}}</text>
    </view>
  </view>
  <view class="express-empty" wx:else><text class="express-empty-title">暂无待处理订单</text><text class="express-empty-desc">切换筛选或稍后刷新</text></view>
</view>
