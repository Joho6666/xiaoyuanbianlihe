<campus-page-header title="快递服务设置" subtitle="只有 Owner 可以修改" showBack="{{true}}" bindback="onBack" />
<view class="express-page">
  <view class="express-card">
    <text class="express-section-title">{{campusId}} 服务配置</text>
    <view class="express-order-row"><text>接单状态</text><switch checked="{{form.acceptingOrders}}" bindchange="onToggle" color="#2f76ff" /></view>
    <text class="express-label">基础价格（分 / 件，旧配置回退）</text><input class="express-input" type="number" value="{{form.basePriceCents}}" data-key="basePriceCents" bindinput="onInput" />
    <text class="express-label">每件价格（分）</text><input class="express-input" type="number" value="{{form.perPackagePriceCents}}" data-key="perPackagePriceCents" bindinput="onInput" />
    <text class="express-label">基础订单费（分）</text><input class="express-input" type="number" value="{{form.baseOrderPriceCents}}" data-key="baseOrderPriceCents" bindinput="onInput" />
    <text class="express-label">额外快递点费用（分 / 点）</text><input class="express-input" type="number" value="{{form.extraPickupPointPriceCents}}" data-key="extraPickupPointPriceCents" bindinput="onInput" />
    <text class="express-label">包裹规格价格配置（JSON）</text><textarea class="express-textarea config-editor" value="{{form.parcelPricingJson}}" data-key="parcelPricingJson" bindinput="onInput" />
    <text class="express-label">截单时间</text><input class="express-input" placeholder="例如 20:30" value="{{form.cutoffTime}}" data-key="cutoffTime" bindinput="onInput" />
    <text class="express-label">配送时间</text><input class="express-input" placeholder="例如 21:00-22:00" value="{{form.deliveryWindow}}" data-key="deliveryWindow" bindinput="onInput" />
    <text class="express-label">快递点配置（可增删、排序、停用）</text><textarea class="express-textarea config-editor" value="{{form.pickupJson}}" data-key="pickupJson" bindinput="onInput" />
    <text class="express-label">宿舍配置（可增删、排序、停用）</text><textarea class="express-textarea config-editor" value="{{form.deliveryJson}}" data-key="deliveryJson" bindinput="onInput" />
    <text class="express-note">快递点字段：id、name、shortName、aliases（截图识别别名）、deliveryCampus、address、openingHours、enabled、sortOrder。宿舍字段：id、name、enabled、dormAreas、buildings。历史订单使用名称快照。</text>
    <text class="express-label">特殊件提示</text><textarea class="express-textarea" value="{{form.specialParcelNotice}}" data-key="specialParcelNotice" bindinput="onInput" /><text class="express-label">公告</text><textarea class="express-textarea" value="{{form.notice}}" data-key="notice" bindinput="onInput" />
    <view class="express-button" bindtap="onSave">{{saving ? '保存中…' : '保存设置'}}</view>
  </view>
</view>
