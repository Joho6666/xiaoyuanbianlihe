<campus-page-header title="快递服务设置" subtitle="只有 Owner 可以修改" showBack="{{true}}" bindback="onBack" /><view class="express-page"><view class="express-card"><text class="express-section-title">{{campusId}} 服务配置</text><view class="express-order-row"><text>接单状态</text><switch checked="{{form.acceptingOrders}}" bindchange="onToggle" color="#2f76ff" /></view><text class="express-label">基础价格（分 / 件）</text><input class="express-input" type="number" value="{{form.basePriceCents}}" data-key="basePriceCents" bindinput="onInput" /><text class="express-label">截单时间</text><input class="express-input" placeholder="例如 20:30" value="{{form.cutoffTime}}" data-key="cutoffTime" bindinput="onInput" /><text class="express-label">配送时间</text><input class="express-input" placeholder="例如 08:00-22:00" value="{{form.deliveryWindow}}" data-key="deliveryWindow" bindinput="onInput" /><text class="express-label">公告</text><textarea class="express-textarea" value="{{form.notice}}" data-key="notice" bindinput="onInput" /><text class="express-label">快递点名称</text><input class="express-input" value="{{form.pointName}}" data-key="pointName" bindinput="onInput" /><view class="express-button" bindtap="onSave">{{saving ? '保存中…' : '保存设置'}}</view></view></view>
