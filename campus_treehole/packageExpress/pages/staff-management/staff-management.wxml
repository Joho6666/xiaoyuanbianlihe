<campus-page-header title="工作人员管理" subtitle="授权前请确认公开用户 ID" showBack="{{true}}" bindback="onBack" /><view class="express-page"><view class="express-card"><text class="express-section-title">当前工作人员</text><view class="express-order-row" wx:for="{{staffList}}" wx:key="staffId"><view class="express-order-main"><text class="express-order-no">{{item.displayName}}</text><text class="express-order-meta">{{item.userId}} · {{item.campusLabel}}</text><text class="express-chip {{item.tone}}">{{item.statusLabel}}</text></view><view class="express-button danger small" wx:if="{{item.status === 'active'}}" bindtap="disable" data-id="{{item.staffId}}">停用</view></view><view class="express-empty" wx:if="{{!staffList.length}}"><text class="express-empty-title">还没有工作人员</text><text class="express-empty-desc">先让工作人员正常登录小程序</text></view></view><view class="express-card"><text class="express-section-title">添加工作人员</text><input class="express-input" placeholder="输入对方的公开用户 ID" value="{{targetUserId}}" bindinput="onTargetInput" /><view class="express-button" bindtap="add">查找并确认</view></view></view>
