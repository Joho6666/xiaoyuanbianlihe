/* packageRide/pages/my-rides/my-rides.wxss */
.my-rides-page {
  padding: 24rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: var(--text-sm);
  background: var(--surface-container);
  color: var(--on-surface);
}

.tab-active {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--surface-container);
  border-radius: var(--radius-md);
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: var(--text-sm);
  color: var(--on-surface);
}

.entry-arrow {
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
}

.ride-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 140rpx;
}

.ride-card {
  padding: 28rpx;
}

.ride-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.ride-route {
  flex: 1;
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--on-surface);
}

.status-chip {
  font-size: var(--text-xs);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.status-chip.active {
  background: rgba(47, 118, 255, 0.12);
  color: var(--primary);
}

.status-chip.departed {
  background: rgba(76, 175, 80, 0.12);
  color: #2e7d32;
}

.status-chip.closed {
  background: var(--surface-container-high);
  color: var(--on-surface-variant);
}

.ride-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
}

.load-more {
  text-align: center;
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
  padding: 16rpx 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dim));
  color: var(--on-primary);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
  z-index: 10;
}
