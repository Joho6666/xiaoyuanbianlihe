/* packageRide/pages/ride-requests/ride-requests.wxss */
.requests-page {
  padding: 24rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tab {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: var(--text-sm);
  background: var(--surface-container);
  color: var(--on-surface);
}

.tab-active {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

.request-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.request-card {
  padding: 28rpx;
}

.request-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--surface-container);
}

.head-main {
  flex: 1;
}

.request-name {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--on-surface);
}

.request-sub {
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
  margin-top: 4rpx;
}

.req-status {
  font-size: var(--text-xs);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-container-high);
  color: var(--on-surface-variant);
}

.req-PENDING {
  background: rgba(255, 171, 64, 0.15);
  color: #b26a00;
}

.req-ACCEPTED {
  background: rgba(76, 175, 80, 0.12);
  color: #2e7d32;
}

.req-REJECTED {
  background: rgba(226, 84, 62, 0.1);
  color: #c0392b;
}

.request-route {
  margin-top: 20rpx;
  font-size: var(--text-sm);
  color: var(--on-surface);
}

.request-time {
  color: var(--on-surface-variant);
  font-size: var(--text-xs);
}

.request-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.req-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: var(--text-sm);
  line-height: 2.2;
  padding: 0;
}

.req-btn.primary {
  background: var(--primary);
  color: var(--on-primary);
}

.req-btn.ghost {
  background: var(--surface-container);
  color: var(--on-surface);
}

.load-more {
  text-align: center;
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
  padding: 16rpx 0;
}
