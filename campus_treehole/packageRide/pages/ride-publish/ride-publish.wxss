/* packageRide/pages/ride-publish/ride-publish.wxss */
.publish-page {
  padding: 24rpx;
}

.field-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.field-label {
  font-size: var(--text-sm);
  color: var(--on-surface-variant);
  margin-bottom: 16rpx;
}

.field-label.small {
  margin-top: 28rpx;
}

.place-cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.place-icon.start {
  color: var(--primary);
}

.place-value {
  flex: 1;
  font-size: var(--text-md);
  color: var(--on-surface);
  font-weight: 500;
}

.place-value.placeholder {
  color: var(--on-surface-variant);
  font-weight: 400;
}

.cell-arrow {
  color: var(--on-surface-variant);
}

.divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 20rpx 0;
}

.mode-row {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  border-radius: var(--radius-md);
  font-size: var(--text-md);
  line-height: 2.2;
  padding: 0;
  background: var(--surface-container);
  color: var(--on-surface);
}

.mode-btn.active {
  background: var(--primary);
  color: var(--on-primary);
}

.schedule-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.schedule-picker {
  background: var(--surface-container);
  border-radius: var(--radius-md);
  padding: 16rpx 24rpx;
  font-size: var(--text-md);
  color: var(--on-surface);
}

.chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: var(--text-xs);
  background: var(--surface-container);
  color: var(--on-surface);
}

.chip-active {
  background: var(--primary-container);
  color: var(--on-primary-container);
  font-weight: 600;
}

.stepper-row {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.stepper-btn {
  width: 72rpx;
  line-height: 2;
  padding: 0;
  border-radius: 50%;
  background: var(--surface-container);
  color: var(--on-surface);
  font-size: var(--text-lg);
}

.stepper-value {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--on-surface);
  min-width: 96rpx;
  text-align: center;
}

.note-input {
  width: 100%;
  min-height: 140rpx;
  background: var(--surface-container);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--text-md);
  box-sizing: border-box;
}

.note-count {
  text-align: right;
  font-size: var(--text-xs);
  color: var(--on-surface-variant);
  margin-top: 8rpx;
}

.submit-btn {
  margin-top: 16rpx;
}
