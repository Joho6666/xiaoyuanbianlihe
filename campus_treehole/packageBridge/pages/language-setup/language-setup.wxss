/* packageBridge/pages/language-setup/language-setup.wxss */
.setup-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2c3338;
  margin-bottom: 12rpx;
}

.card-hint {
  font-size: 22rpx;
  color: #747c81;
  margin-bottom: 20rpx;
}

.radio-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 12rpx;
}

.radio-item {
  font-size: 26rpx;
  color: #596065;
  display: flex;
  align-items: center;
}

.input-group {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(116, 124, 129, 0.08);
}

.input-label {
  display: block;
  font-size: 24rpx;
  color: #747c81;
  margin-bottom: 12rpx;
}

.text-input {
  width: 100%;
  height: 80rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
}

.chips-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.chip-cell {
  background: #f8fafc;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chip-native-active {
  background: #e0f2fe;
  border-color: #0284c7;
}

.chip-native-active .chip-title {
  color: #0369a1;
  font-weight: 800;
}

.chip-target-active {
  background: #fef3c7;
  border-color: #d97706;
}

.chip-target-active .chip-title {
  color: #b45309;
  font-weight: 800;
}

.chip-title {
  font-size: 26rpx;
  color: #2c3338;
}

.chip-sub {
  font-size: 20rpx;
  color: #747c81;
  text-transform: uppercase;
}

.bio-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
  line-height: 1.5;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(44, 51, 56, 0.04);
  z-index: 100;
}

.save-btn {
  background: #0284c7;
  color: #ffffff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.save-btn:active {
  opacity: 0.9;
}
