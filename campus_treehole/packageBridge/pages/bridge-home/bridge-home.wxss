/* packageBridge/pages/bridge-home/bridge-home.wxss */
.bridge-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #2c3338;
}

.brand-sub {
  font-size: 22rpx;
  color: #747c81;
}

.locale-toggle {
  display: flex;
  background: #e0f2fe;
  border-radius: 999rpx;
  padding: 4rpx;
}

.locale-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #0369a1;
}

.locale-active {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0369a1;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(3, 105, 161, 0.2);
}

.notice-banner {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(2, 132, 199, 0.25);
}

.banner-badge {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.25);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.banner-meta {
  font-size: 20rpx;
  opacity: 0.9;
}

.profile-cta-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  border: 1rpx solid #e0f2fe;
}

.cta-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0369a1;
}

.cta-sub {
  font-size: 20rpx;
  color: #747c81;
  margin-top: 4rpx;
}

.cta-btn {
  background: #0284c7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.type-filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: #747c81;
  border: 1rpx solid rgba(116, 124, 129, 0.1);
}

.type-tab-active {
  background: #0284c7;
  color: #ffffff;
  font-weight: 700;
  border-color: #0284c7;
}

.partner-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
  position: relative;
  overflow: hidden;
}

.match-ribbon {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 0 28rpx 0 16rpx;
}

.card-main {
  display: flex;
  gap: 20rpx;
}

.partner-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.partner-body {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.partner-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #2c3338;
}

.country-badge {
  font-size: 20rpx;
  background: #f1f4f8;
  color: #596065;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.identity-badge {
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.lang-tags-box {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 10rpx 14rpx;
  margin-top: 8rpx;
}

.lang-line {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.8;
}

.lang-role {
  color: #747c81;
  width: 120rpx;
}

.lang-chips {
  display: flex;
  gap: 8rpx;
}

.chip-native {
  background: #e0f2fe;
  color: #0369a1;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  text-transform: uppercase;
}

.chip-learning {
  background: #fef3c7;
  color: #b45309;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  text-transform: uppercase;
}

.partner-bio {
  font-size: 22rpx;
  color: #596065;
  margin-top: 10rpx;
  line-height: 1.4;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(116, 124, 129, 0.08);
}

.exchange-mode {
  font-size: 20rpx;
  color: #747c81;
}

.connect-btn {
  background: #0284c7;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 0 28rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  margin: 0;
}

.loading-bar, .empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #abb3b9;
  font-size: 24rpx;
}

.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; color: #334155; margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: #94a3b8; margin-bottom: 30rpx; }
.empty-btn { background: #426089; color: #ffffff; font-size: 28rpx; font-weight: 700; border-radius: 999rpx; padding: 0 48rpx; height: 74rpx; line-height: 74rpx; }
