/* packageMutual/pages/mutual-detail/mutual-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.status-banner {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.status-open {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
}

.status-in_progress {
  background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
  color: #ffffff;
}

.status-resolved, .status-closed {
  background: #64748b;
  color: #ffffff;
}

.status-title {
  font-size: 32rpx;
  font-weight: 800;
}

.status-date {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.type-tag {
  font-size: 20rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.cat-tag {
  font-size: 20rpx;
  background: #f1f4f8;
  color: #596065;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.reward-tag {
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.post-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2c3338;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.post-content {
  font-size: 26rpx;
  color: #596065;
  line-height: 1.6;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.post-img {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
}

.location-box {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.loc-label {
  color: #747c81;
}

.loc-val {
  color: #2c3338;
  font-weight: 600;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.author-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3338;
}

.auth-tag {
  font-size: 20rpx;
  color: #059669;
}

.chat-btn {
  background: #ecf2fb;
  color: #426089;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(44, 51, 56, 0.04);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
}

.btn-primary {
  background: #426089;
  color: #ffffff;
}

.btn-secondary {
  background: #ecfdf5;
  color: #059669;
}

.btn-danger {
  background: #fee2e2;
  color: #dc2626;
}
