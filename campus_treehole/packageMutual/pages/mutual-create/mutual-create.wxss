/* packageMutual/pages/mutual-create/mutual-create.wxss */
.create-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.group-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 14rpx;
}

.type-radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio-pill {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #596065;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.pill-active {
  background: #e9eff7;
  color: #426089;
  font-weight: 700;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-chip {
  padding: 12rpx 24rpx;
  background: #f8fafc;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #596065;
  border: 2rpx solid transparent;
}

.cat-chip-active {
  background: #e9eff7;
  border-color: #426089;
  color: #426089;
  font-weight: 700;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.input-control {
  width: 100%;
  height: 80rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
}

.placeholder-text {
  color: #abb3b9;
  font-size: 24rpx;
}

.textarea-control {
  width: 100%;
  height: 200rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #2c3338;
  line-height: 1.5;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 10rpx;
}

.preview-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  position: relative;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.del-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.add-box {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx dashed #d1d5db;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  font-size: 40rpx;
  color: #9ca3af;
  line-height: 1;
}

.add-tip {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(44, 51, 56, 0.04);
  z-index: 100;
}

.submit-btn {
  background: #426089;
  color: #ffffff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.submit-btn:active {
  opacity: 0.9;
}
