/* packageMutual/pages/mutual-list/mutual-list.wxss */
.mutual-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.top-nav-bar {
  background: #ffffff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.08);
}

.segmented-control {
  display: flex;
  background: #f1f4f8;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #747c81;
}

.seg-item-active {
  background: #ffffff;
  color: #426089;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(66, 96, 137, 0.15);
}

.sub-tab-bar {
  display: flex;
  background: #ffffff;
  padding: 10rpx 32rpx 16rpx;
  gap: 16rpx;
}

.sub-tab {
  font-size: 22rpx;
  color: #747c81;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
}

.sub-tab-active {
  background: #e9eff7;
  color: #426089;
  font-weight: 700;
}

.cat-scroll {
  display: flex;
  white-space: nowrap;
  background: #ffffff;
  padding: 12rpx 24rpx 18rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(116, 124, 129, 0.06);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  background: #f1f4f8;
  border-radius: 999rpx;
  margin-right: 14rpx;
  font-size: 22rpx;
  color: #596065;
}

.cat-chip-active {
  background: #e9eff7;
  color: #426089;
  font-weight: 700;
  border: 1rpx solid #426089;
}

.post-list {
  padding: 24rpx;
}

.help-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.header-tags {
  display: flex;
  gap: 12rpx;
}

.help-type-tag {
  font-size: 20rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.reward-tag {
  font-size: 20rpx;
  background: #fef3c7;
  color: #b45309;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.status-open {
  background: #ecfdf5;
  color: #059669;
}

.status-in_progress {
  background: #fef3c7;
  color: #b45309;
}

.status-resolved, .status-closed {
  background: #f1f4f8;
  color: #9ca3af;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3338;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.card-content {
  font-size: 24rpx;
  color: #596065;
  line-height: 1.5;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  font-size: 22rpx;
  color: #747c81;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.meta-icon {
  margin-right: 6rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(116, 124, 129, 0.08);
}

.user-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.username {
  font-size: 22rpx;
  color: #747c81;
}

.time-text {
  font-size: 20rpx;
  color: #abb3b9;
}

/* 失物招领横排图文卡片 */
.lost-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 51, 56, 0.03);
  border: 1rpx solid rgba(116, 124, 129, 0.06);
  display: flex;
  gap: 20rpx;
}

.lost-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.lost-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.lost-type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.type-lost {
  background: #fff7ed;
  color: #c2410c;
}

.type-found {
  background: #ecfdf5;
  color: #059669;
}

.empty-state, .loading-bar {
  text-align: center;
  padding: 80rpx 0;
  color: #abb3b9;
  font-size: 24rpx;
}

.empty-btn {
  background: #426089;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-top: 20rpx;
}

.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 160rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #426089;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(66, 96, 137, 0.4);
  z-index: 100;
}

.fab-plus {
  font-size: 36rpx;
  line-height: 1;
}

.fab-text {
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; color: #334155; margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: #94a3b8; margin-bottom: 30rpx; }
.empty-btn { background: #426089; color: #ffffff; font-size: 28rpx; font-weight: 700; border-radius: 999rpx; padding: 0 48rpx; height: 74rpx; line-height: 74rpx; }
