.status-chip{display:inline-flex;padding:6rpx 14rpx;border-radius:999rpx;font-size:21rpx;background:var(--surface-container);color:var(--on-surface-variant)}.status-chip-success{background:var(--success-container);color:var(--on-success-container)}.status-chip-info{background:var(--info-container);color:var(--on-info-container)}.status-chip-coral{background:var(--accent-soft);color:var(--accent)}.status-chip-warning{background:#fff1dc;color:#a85d00}
