<view class="product-card" bindtap="onTap"><image wx:if="{{item.images && item.images.length}}" class="product-cover" src="{{item.images[0]}}" mode="aspectFill"/><view wx:else class="product-cover product-cover-empty">📦</view><view class="product-body"><view class="product-title">{{item.title}}</view><price-text amount="{{item.price}}" original="{{item.originalPrice}}"/><view class="product-meta"><text wx:if="{{item.condition}}">{{item.condition}}</text><text wx:if="{{item.tradeMethod}}"> · {{item.tradeMethod}}</text><status-chip wx:if="{{item.statusLabel}}" text="{{item.statusLabel}}" tone="{{item.statusTone || 'neutral'}}"/><text class="product-favorite" catchtap="onFavorite">{{item.isFavored ? '★' : '☆'}}</text></view><view class="product-seller"><image src="{{item.avatar || '/images/avatar_default.png'}}"/><text>{{item.nickname || '匿名卖家'}}</text></view></view></view>
