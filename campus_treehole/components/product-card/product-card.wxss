.product-card{overflow:hidden;border-radius:var(--radius-lg);background:var(--surface-container-lowest);box-shadow:var(--shadow-card)}.product-cover{display:block;width:100%;height:320rpx;background:var(--surface-container)}.product-cover-empty{display:flex;align-items:center;justify-content:center;font-size:64rpx}.product-body{padding:22rpx}.product-title{font-size:28rpx;font-weight:700;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.product-meta{display:flex;align-items:center;gap:8rpx;margin-top:12rpx;color:var(--on-surface-variant);font-size:22rpx}.product-favorite{margin-left:auto;font-size:28rpx;color:var(--accent)}.product-seller{display:flex;align-items:center;gap:8rpx;margin-top:14rpx;color:var(--on-surface-variant);font-size:21rpx}.product-seller image{width:34rpx;height:34rpx;border-radius:50%}
