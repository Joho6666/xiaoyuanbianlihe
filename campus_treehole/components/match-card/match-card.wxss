.match-card{display:flex;align-items:center;gap:18rpx;padding:22rpx;margin-bottom:18rpx;border-radius:var(--radius-lg);background:var(--surface-container-lowest);box-shadow:var(--shadow-card)}.match-card image{width:72rpx;height:72rpx;border-radius:50%}.match-copy{flex:1}.match-title{font-size:28rpx;font-weight:700}.match-meta{margin-top:4rpx;color:var(--on-surface-variant);font-size:22rpx}.match-card button{margin:0;padding:0 22rpx;height:58rpx;line-height:58rpx;border:0;border-radius:999rpx;background:var(--accent);color:#fff;font-size:22rpx}
