<view class="buddy-card" bindtap="onTap"><view class="buddy-card-top"><status-chip text="{{item.urgencyBadge || item.timeDisplay || '校园组局'}}" tone="{{item.status === 'OPEN' ? 'success' : 'neutral'}}"/><text class="buddy-category">{{item.categoryName || item.category || '找搭子'}}</text></view><view class="buddy-title">{{item.title}}</view><view class="buddy-meta"><text>⏱ {{item.timeDisplay || item.startTime || item.timeStr || '时间待定'}}</text><text>⌖ {{item.location || '地点待定'}}</text></view><view class="buddy-count"><text>已报名 {{item.acceptedCount || item.joinedCount || item.currentCount || 0}}/{{item.maxPeople || item.maxParticipants || item.maxCount || 0}}</text><text class="buddy-remaining" wx:if="{{item.remainPeople > 0}}">还差 {{item.remainPeople}} 人</text></view><view class="buddy-host"><image src="{{item.author.avatarUrl || item.avatar || '/images/avatar_default.png'}}"/><text>{{item.author.nickName || item.nickname || '发起人'}}</text><text class="buddy-arrow">›</text></view></view>
