.buddy-card{padding:26rpx;margin-bottom:20rpx;border-radius:var(--radius-lg);background:var(--surface-container-lowest);box-shadow:var(--shadow-card)}.buddy-card-top{display:flex;align-items:center;gap:14rpx}.buddy-category{font-size:22rpx;color:var(--on-surface-variant)}.buddy-title{margin-top:16rpx;font-size:31rpx;font-weight:750;color:var(--on-surface);line-height:1.4}.buddy-meta{display:flex;gap:22rpx;margin-top:14rpx;color:var(--on-surface-variant);font-size:23rpx}.buddy-count{display:flex;justify-content:space-between;margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid var(--hairline);font-size:23rpx;color:var(--on-surface-variant)}.buddy-remaining{color:var(--primary);font-weight:700}.buddy-host{display:flex;align-items:center;gap:10rpx;margin-top:16rpx;color:var(--on-surface-variant);font-size:22rpx}.buddy-host image{width:38rpx;height:38rpx;border-radius:50%}.buddy-arrow{margin-left:auto;font-size:32rpx;color:var(--outline-variant)}
