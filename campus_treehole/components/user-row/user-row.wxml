<view class="user-row" bindtap="onTap"><image class="user-row-avatar" src="{{avatar || item.avatar || item.avatarUrl || '/images/avatar_default.png'}}" mode="aspectFill"/><view class="user-row-copy"><view class="user-row-name">{{name || item.nickname || item.nickName || '同学'}}</view><view class="user-row-meta" wx:if="{{meta || item.meta}}">{{meta || item.meta}}</view></view><text class="user-row-badge" wx:if="{{badge || item.badge}}">{{badge || item.badge}}</text><text class="user-row-arrow">›</text></view>
