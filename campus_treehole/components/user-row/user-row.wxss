.user-row{display:flex;align-items:center;gap:18rpx;padding:22rpx 0}.user-row-avatar{width:76rpx;height:76rpx;border-radius:50%;background:var(--surface-container)}.user-row-copy{flex:1;min-width:0}.user-row-name{font-size:28rpx;font-weight:700;color:var(--on-surface)}.user-row-meta{margin-top:4rpx;font-size:22rpx;color:var(--on-surface-variant);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.user-row-badge{padding:6rpx 12rpx;border-radius:999rpx;background:var(--surface-container-low);color:var(--primary);font-size:21rpx}.user-row-arrow{font-size:36rpx;color:var(--outline-variant)}
