.fate-card{padding:56rpx 34rpx;text-align:center;border-radius:var(--radius-xl);background:linear-gradient(145deg,#fff7f4,#fff);box-shadow:var(--shadow-card)}.fate-mark{font-size:72rpx;color:var(--accent)}.fate-title{margin-top:10rpx;font-size:36rpx;font-weight:800;color:var(--on-surface)}.fate-sub{margin-top:8rpx;color:var(--on-surface-variant);font-size:24rpx}.fate-card button{margin:30rpx auto 0;width:220rpx;height:70rpx;line-height:70rpx;border-radius:999rpx;background:var(--accent);color:#fff;font-size:26rpx}.fate-score{margin-top:24rpx;font-size:34rpx;font-weight:800;color:var(--accent)}.fate-interests{margin-top:14rpx;color:var(--on-surface-variant);font-size:24rpx}.fate-actions{display:flex;justify-content:center;gap:16rpx}.fate-actions button{width:auto;padding:0 24rpx;background:var(--surface-container-low);color:var(--on-surface-variant)}.fate-actions .fate-like{background:var(--accent);color:#fff}
