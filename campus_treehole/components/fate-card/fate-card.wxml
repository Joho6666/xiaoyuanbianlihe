<view class="fate-card {{revealed ? 'fate-card-revealed' : ''}}"><block wx:if="{{!revealed}}"><view class="fate-mark">✦</view><view class="fate-title">今日缘分</view><view class="fate-sub">翻开一张校园同频卡</view><button bindtap="onReveal">揭开</button></block><block wx:else><view class="fate-title">今日缘分</view><view class="fate-score" wx:if="{{item.score != null}}">同频指数 {{item.score}}</view><view class="fate-interests" wx:if="{{item.interests}}">共同兴趣：{{item.interests}}</view><view class="fate-actions"><button bindtap="onPass">暂时没感觉</button><button class="fate-like" bindtap="onLike">喜欢</button></view></block></view>
