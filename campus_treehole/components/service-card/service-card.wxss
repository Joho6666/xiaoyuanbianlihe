.service-card{display:flex;align-items:center;gap:20rpx;padding:28rpx;background:var(--surface-container-lowest);border-radius:var(--radius-lg);box-shadow:var(--shadow-card);}.service-card-icon{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;background:var(--info-container);}.service-card-green .service-card-icon{background:var(--success-container)}.service-card-coral .service-card-icon{background:var(--accent-soft)}.service-card-copy{flex:1;min-width:0}.service-card-title{font-size:30rpx;font-weight:750;color:var(--on-surface)}.service-card-description{margin-top:4rpx;font-size:23rpx;color:var(--on-surface-variant);}.service-card-badge{padding:6rpx 12rpx;border-radius:999rpx;background:var(--surface-container-low);color:var(--primary);font-size:21rpx}.service-card-arrow{font-size:40rpx;color:var(--outline-variant)}
