.content-card{margin-bottom:24rpx;overflow:hidden;border-radius:var(--radius-lg);background:var(--surface-container-lowest);box-shadow:var(--shadow-card)}.content-card-cover{display:block;width:100%;height:360rpx;background:var(--surface-container)}.content-card-body{padding:24rpx 26rpx 22rpx}.content-card-title{font-size:30rpx;font-weight:750;line-height:1.4;color:var(--on-surface);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.content-card-summary{margin-top:8rpx;color:var(--on-surface-variant);font-size:24rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.content-card-meta{display:flex;align-items:center;gap:8rpx;margin-top:18rpx;color:var(--on-surface-variant);font-size:22rpx}.content-card-avatar{width:40rpx;height:40rpx;border-radius:50%}.content-card-actions{margin-left:auto;display:flex;gap:18rpx;font-size:24rpx}.content-card-compact .content-card-cover{height:260rpx}
