<view class="content-card {{compact ? 'content-card-compact' : ''}}" bindtap="onTap"><image wx:if="{{item._coverSrc || item.cover || item.image}}" class="content-card-cover" src="{{item._coverSrc || item.cover || item.image}}" mode="aspectFill"/><view class="content-card-body"><view class="content-card-title">{{item.title || item.content}}</view><view class="content-card-summary" wx:if="{{item.content && item.title}}">{{item.content}}</view><view class="content-card-meta"><image class="content-card-avatar" src="{{item.avatar || '/images/avatar_default.png'}}"/><text>{{item.nickname || '匿名'}}</text><text wx:if="{{item.location}}"> · {{item.location}}</text><view class="content-card-actions"><text catchtap="onFavorite">{{item.isFavored ? '★' : '☆'}}</text><text catchtap="onLike">{{item.isLiked ? '♥' : '♡'}} {{item.likes || 0}}</text></view></view></view></view>
