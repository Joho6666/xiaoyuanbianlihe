.heart-card{display:flex;gap:22rpx;padding:26rpx;margin-bottom:20rpx;border-radius:var(--radius-lg);background:var(--surface-container-lowest);box-shadow:var(--shadow-card)}.heart-avatar{width:148rpx;height:188rpx;border-radius:24rpx;object-fit:cover;background:var(--accent-soft)}.heart-copy{flex:1;min-width:0}.heart-name{font-size:30rpx;font-weight:750}.heart-meta{margin-top:6rpx;font-size:22rpx;color:var(--on-surface-variant)}.heart-interests{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:16rpx}.heart-interests text{padding:6rpx 12rpx;border-radius:999rpx;background:var(--accent-soft);color:var(--accent);font-size:21rpx}.heart-score{margin-top:18rpx;font-size:22rpx;color:var(--on-surface-variant)}.heart-score text{margin-left:6rpx;font-size:30rpx;font-weight:800;color:var(--accent)}.heart-actions{display:flex;flex-direction:column;gap:10rpx;align-self:flex-end}.heart-actions button{margin:0;padding:0 18rpx;height:56rpx;line-height:56rpx;border-radius:999rpx;background:var(--surface-container-low);color:var(--on-surface-variant);font-size:22rpx}.heart-actions .heart-like{background:var(--accent);color:#fff}
