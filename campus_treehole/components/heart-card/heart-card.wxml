<view class="heart-card" bindtap="onTap"><image class="heart-avatar" src="{{item.avatar || item.avatarUrl || (item.photos && item.photos[0]) || '/images/avatar_default.png'}}" mode="aspectFill"/><view class="heart-copy"><button catchtap="onSafety" size="mini">举报 / 拉黑</button><view wx:if="{{item.bio}}">{{item.bio}}</view><view wx:if="{{item.lookingFor}}">最近想做：{{item.lookingFor}}</view><button wx:if="{{item.recentBuddy}}" catchtap="onBuddy" size="mini">{{item.recentBuddy.title}} · 公开搭子</button><view class="heart-name">{{item.nickname || item.nickName || '同频同学'}}</view><view class="heart-meta">{{item.schoolName || item.campusName || '同校'}} · {{item.genderLabel || ''}}</view><view class="heart-interests" wx:if="{{item.sharedInterests && item.sharedInterests.length}}"><text wx:for="{{item.sharedInterests}}" wx:key="*this">{{item}}</text></view><view class="heart-interests" wx:elif="{{item.interests && item.interests.length}}"><text wx:for="{{item.interests}}" wx:key="*this">{{item}}</text></view><view class="heart-score" wx:if="{{item.score != null || item.syncScore != null || item.matchScore != null}}">同频指数 <text>{{item.score != null ? item.score : (item.syncScore != null ? item.syncScore : item.matchScore)}}</text></view></view><view class="heart-actions"><button disabled="{{busy}}" catchtap="onPass">略过</button><button class="heart-like" disabled="{{busy}}" catchtap="onLike">喜欢</button></view></view>
