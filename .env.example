# ========================================================
# 校园便利盒 · 统一校园平台环境配置模板
# 复制为 .env 并填入实际值。不要将包含真实密钥的 .env 提交到 Git！
# ========================================================

# 微信云开发环境 ID (默认: xyblh-5gb26qrnf9d30feb)
CLOUDBASE_ENV_ID=xyblh-5gb26qrnf9d30feb

# 平台运行环境 (development | staging | production)
APP_ENV=development

# 默认校园 ID (与 utils/campuses.js 对齐)
DEFAULT_CAMPUS_ID=guit-hangtian

# PC 管理后台 H5 源码文件位置 (若为空则默认使用 Desktop/admin后台 兼容路径)
ADMIN_SOURCE_PATH=

# 管理员 Web 匿名访问秘钥 (与 hosting/admin.html 中的密钥对齐)
ADMIN_WEB_SECRET=

# 内部服务通知触发秘钥 (云函数间安全调用)
INTERNAL_NOTIFY_SECRET=

# Express 3.8 OCR：仅独立测试环境临时设置，禁止提交真实密钥
EXPRESS_OCR_PROVIDER=
EXPRESS_OCR_TEST_ENV_ID=
EXPRESS_OCR_MOCK_ALLOWED=false
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
EXPRESS_OCR_SMOKE_IMAGE=
